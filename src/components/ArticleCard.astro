---
import { formatDate } from "../utils";
import type { CollectionEntry } from "astro:content";
import Tags from "./Tags.astro";
import { Image } from "astro:assets";

const { article } = Astro.props;

interface Props {
  article: CollectionEntry<"music">;
}

const articleHref = `/music/${article.id}`;
const coverImageAttribution = article.data.imageAttribution;
---

<div class='card-wrapper'>
  <div class='content-wrapper'>
    <div class='top-wrapper'>
      <h2 class='card-heading'>
        <a href={articleHref}
          >{article.data.title}<span class='asterisk'
            >{coverImageAttribution && " *"}</span
          >{coverImageAttribution && <sup>HA</sup>}</a
        >
      </h2>
      <p>
        category: {article.data.category}
      </p>
      <a href={articleHref}>
        <Image
          src={article.data.coverImage}
          alt='Article Image'
        />
      </a>
    </div>
    <div class='tags-wrapper'>
      <Tags
        isMusic={true}
        tags={article.data.tags}
      />
    </div>
  </div>
</div>

<style>
  .card-wrapper {
    margin-block-start: 2.5rem;
    max-width: 28rem;
    margin-block: auto;
    box-shadow:
      0 10px 15px -3px hsl(from var(--text-color-700) h s l / 0.1),
      0 4px 6px -4px hsl(from var(--text-color-700) h s l / 0.1);
    width: 100%;
    height: 100%;
  }

  .content-wrapper {
    background-color: white;
    border-radius: 10px;
    overflow: hidden;
    color: var(--text-color-700);
    height: 100%;
    padding-block-start: 0.5rem;
    display: flex;
    flex-direction: column;
    text-align: center;

    img {
      width: 100%;
      height: auto;
      object-fit: cover;
      transition: 0.3s ease-in-out;

      &:hover {
        opacity: 0.75;
      }
    }

    .tags-wrapper {
      padding: 0rem 1rem;
      margin-block-start: 1rem;
    }

    p {
      font-size: 0.85rem;
      margin-block-end: 0.75rem;
    }
  }

  .content-wrapper .card-heading {
    font-size: clamp(1.125rem, 0.435vw + 0.902rem, 1.25rem);
    margin-block-start: 0.5rem;
    padding-inline: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 3lh;
  }

  .asterisk {
    font-size: 1rem;
  }
</style>
