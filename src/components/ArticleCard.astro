---
import { formatDate } from "../utils";
import type { CollectionEntry } from "astro:content";
import Tags from "./Tags.astro";
import { Image } from "astro:assets";

const { article } = Astro.props;

interface Props {
  article: CollectionEntry<"music">;
}

const articleHref = `/music/${article.id}`;
const coverImageAttribution = article.data.imageAttribution;
---

<div class='card-wrapper'>
  <div class='content-wrapper'>
    <a href={articleHref}>
      <Image
        src={article.data.coverImage}
        alt='Article Image'
      />
    </a>
    <div class='content-bottom'>
      <h2 class='card-heading'>
        <a href={articleHref}>{article.data.title}</a>
      </h2>
      <p>
        category: {article.data.category}
      </p>
      <Tags tags={article.data.tags} />
      {
        coverImageAttribution && (
          <p class='img-attributtion'>{coverImageAttribution}</p>
        )
      }
    </div>
  </div>
</div>

<style>
  .card-wrapper {
    margin-block-start: 2.5rem;
    max-width: 28rem;
    margin-block: auto;
    box-shadow:
      0 10px 15px -3px hsl(from var(--text-color-700) h s l / 0.1),
      0 4px 6px -4px hsl(from var(--text-color-700) h s l / 0.1);
    width: 100%;
    height: 100%;
  }

  .content-wrapper {
    background-color: white;
    border-radius: 10px;
    overflow: hidden;
    color: var(--text-color-700);
    height: 100%;
    position: relative;
    padding-block-end: 1rem;

    img {
      width: 100%;
      height: auto;
      object-fit: cover;
      transition: 0.3s ease-in-out;

      &:hover {
        opacity: 0.75;
      }
    }

    .content-bottom {
      padding: 1.25rem;
    }

    .card-heading {
      font-size: 1.5rem;
      font-weight: 600;
      margin-block-end: 0.5rem;
    }

    p {
      font-size: 0.85rem;
      margin-block-end: 0.75rem;
    }
  }

  .img-attributtion {
    position: absolute;
    bottom: 0.5rem;
  }
</style>
