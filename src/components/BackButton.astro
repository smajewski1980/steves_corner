<button
  class='back-link form-shadow'
  id='back-button'
  >Back</button
>

<script>
  function setupBackButton() {
    const btns = document.querySelectorAll(".back-link");
    const backBtn = btns[0];
    const backBtnLower = btns[1];
    if (!backBtn) return;

    [backBtn, backBtnLower].forEach((btn) => {
      if (!btn) return;

      btn.addEventListener("click", () => {
        // Check if the user came from this site
        const hasInternalReferrer =
          document.referrer && document.referrer.includes(window.location.host);

        if (hasInternalReferrer && window.history.length > 1) {
          window.history.back();
        } else {
          console.log("nowhere to go");
          return;
        }
      });
    });
  }

  setupBackButton();
</script>

<style>
  .back-link {
    background-color: var(--footer-header-bg);
    outline: 1px solid currentColor;
    border-radius: 5px;
    color: var(--text-color-700);
    cursor: pointer;
    font: inherit;
    outline: 1px solid var(--text-color-700);
    padding: 0.75rem 1.5rem;
    transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);

    &:hover,
    &:focus-visible {
      box-shadow: none;
      transform: translate(-2px, 2px);
    }
  }
</style>
