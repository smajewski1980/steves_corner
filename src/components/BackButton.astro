<button
  class='back-link'
  id='back-button'
  >Back</button
>

<script>
  function setupBackButton() {
    const btns = document.querySelectorAll(".back-link");
    const backBtn = btns[0];
    const backBtnLower = btns[1];
    if (!backBtn) return;

    [backBtn, backBtnLower].forEach((btn) => {
      if (!btn) return;

      btn.addEventListener("click", () => {
        // Check if the user came from this site
        const hasInternalReferrer =
          document.referrer && document.referrer.includes(window.location.host);

        if (hasInternalReferrer && window.history.length > 1) {
          window.history.back();
        } else {
          console.log("nowhere to go");
          return;
        }
      });
    });
  }

  setupBackButton();
</script>
