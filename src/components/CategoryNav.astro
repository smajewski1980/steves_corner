---
import { MUSIC_COLLECTION_CATEGORIES } from "../content.config";

const cleanedUpCategories: string[] = MUSIC_COLLECTION_CATEGORIES.map((c) =>
  c.replace("-", " "),
);
---

<nav id='category-nav'>
  <h2>CATEGORIES:</h2>
  <ul class='category-nav'>
    {
      cleanedUpCategories.map((c, idx) => (
        <li>
          <a
            href={`/music/category/${MUSIC_COLLECTION_CATEGORIES[idx]}`}
            class='form-shadow'
          >
            {c}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<p class='music-haul-blog-link'>
  <a
    href='/music/music-haul-blog'
    class='form-shadow'
    >WEEKLY MUSIC HAUL BLOG PAGE</a
  >
</p>
<p class='target-cds-page-link'>
  <a
    href='/music/target-cds'
    class='form-shadow'
    >WEA TARGET CDS PAGE</a
  >
</p>

<style>
  #category-nav {
    display: flex;
    padding: 0;
    align-items: center;
    margin-block-end: 0.5rem;
    flex-wrap: wrap;

    @media (max-width: 768px) {
      margin-block-end: 1.5rem;
    }
  }

  h2 {
    margin-inline-end: 1.5rem;
    font-size: var(--heading-2-size);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding: 0;

    @media (max-width: 768px) {
      row-gap: 0rem;
    }
  }

  li {
    text-transform: capitalize;
    word-spacing: -0.5ch;
    /* 
    &:hover,
    &:focus-visible {
      transform: translate(-2px, 2px);
    } */
  }

  p,
  li {
    margin-block: 1rem;
    display: inline-block;
    width: fit-content;

    a {
      border-radius: 5px;
      border: 1px solid var(--text-color-700);
      outline: 1px solid var(--text-color-700);
      outline-offset: -1px;
      transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      padding: 0.5rem;
      text-decoration: none;
      display: block;
      background-color: var(--footer-header-bg);

      &:hover,
      &:focus-visible {
        box-shadow: none;
        transform: translate(-2px, 2px);
      }

      &:focus-visible {
        outline-offset: 5px;
      }
    }
  }

  .music-haul-blog-link {
    margin-inline-end: 2rem;
  }

  .music-haul-blog-link,
  .target-cds-page-link {
    white-space: nowrap;

    &:hover,
    &:focus-visible {
      a {
        box-shadow: none;
      }
      transform: translate(-2px, 2px);
    }
  }
</style>
