---
import { MUSIC_COLLECTION_CATEGORIES } from "../content.config";

const cleanedUpCategories: string[] = MUSIC_COLLECTION_CATEGORIES.map((c) =>
  c.replace("-", " "),
);
---

<nav id='category-nav'>
  <h2>CATEGORIES:</h2>
  <ul class='category-nav'>
    {
      cleanedUpCategories.map((c, idx) => (
        <li>
          -&nbsp;
          <a href={`/music/category/${MUSIC_COLLECTION_CATEGORIES[idx]}`}>
            {c}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<p class='music-haul-blog-link'>
  <a href='/music/music-haul-blog'>CLICK HERE</a> to go to my weekly music haul blog
  page.
</p>
<p class='target-cds-page-link'>
  <a href='/music/target-cds'>CLICK HERE</a> to go to my WEA target cds page.
</p>

<style>
  #category-nav {
    display: flex;
    padding: 0;
    align-items: center;
    margin-block-end: 0.5rem;
    flex-wrap: wrap;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;

    @media (max-width: 800px) {
      margin-block-start: 0.5rem;
      column-gap: 1rem;
      row-gap: 0.25rem;
      padding-inline-start: 0;
    }
  }

  li {
    text-transform: capitalize;
    word-spacing: -0.5ch;
  }

  .music-haul-blog-link,
  .target-cds-page-link {
    margin-block-end: 0.5rem;
    display: block;

    a {
      text-decoration: underline;
      text-underline-offset: 5px;
      font-weight: 700;
      display: inline-block;
    }
  }
  .target-cds-page-link {
    margin-block-end: 2rem;
  }
</style>
