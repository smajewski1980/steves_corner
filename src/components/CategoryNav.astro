---
import { MUSIC_COLLECTION_CATEGORIES } from "../content.config";

const cleanedUpCategories: string[] = MUSIC_COLLECTION_CATEGORIES.map((c) =>
  c.replace("-", " "),
);
---

<nav id='category-nav'>
  <h2>CATEGORIES:</h2>
  <ul class='category-nav'>
    {
      cleanedUpCategories.map((c, idx) => (
        <li>
          <a
            href={`/music/category/${MUSIC_COLLECTION_CATEGORIES[idx]}`}
            class='form-shadow'
          >
            {c}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<p class='music-haul-blog-link'>
  <a
    href='/music/music-haul-blog'
    class='form-shadow'
    >WEEKLY MUSIC HAUL BLOG PAGE</a
  >
</p>
<p class='target-cds-page-link'>
  <a
    href='/music/target-cds'
    class='form-shadow'
    >WEA TARGET CDS PAGE</a
  >
</p>

<style>
  #category-nav {
    display: flex;
    padding: 0;
    align-items: center;
    margin-block-end: 0.5rem;
    flex-wrap: wrap;

    @media (max-width: 768px) {
      margin-block-end: 1.5rem;
    }
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;

    @media (max-width: 800px) {
      margin-block-start: 0.5rem;
      column-gap: 1rem;
      row-gap: 1rem;
      padding-inline-start: 0;
    }
  }

  li {
    text-transform: capitalize;
    word-spacing: -0.5ch;

    &:hover,
    &:focus-visible {
      a {
        box-shadow: none;
      }
      transform: translate(-2px, 2px);
    }
  }

  p,
  li {
    margin-block: 1rem;
    display: inline-block;
    width: fit-content;

    a {
      border-radius: 5px;
      outline: 1px solid var(--text-color-700);
      padding: 0.5rem;
      text-decoration: none;
    }
  }

  .music-haul-blog-link {
    margin-inline-end: 2rem;
  }

  .music-haul-blog-link,
  .target-cds-page-link {
    &:hover,
    &:focus-visible {
      a {
        box-shadow: none;
      }
      transform: translate(-2px, 2px);
    }
  }
</style>
