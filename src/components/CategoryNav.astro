---
import { MUSIC_COLLECTION_CATEGORIES } from "../content.config";

const cleanedUpCategories: string[] = MUSIC_COLLECTION_CATEGORIES.map((c) =>
  c.replace("-", " "),
);
---

<nav id='category-nav'>
  <h2>CATEGORIES:</h2>
  <ul class='category-nav'>
    {
      cleanedUpCategories.map((c, idx) => (
        <li>
          <a href={`/music/category/${MUSIC_COLLECTION_CATEGORIES[idx]}`}>
            - {c}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  #category-nav {
    display: flex;
    padding: 0;
    align-items: center;
    margin-block-end: 1rem;
    flex-wrap: wrap;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;

    @media (max-width: 800px) {
      margin-block-start: 0.5rem;
      column-gap: 1rem;
      row-gap: 0.25rem;
      padding-inline-start: 0;
    }
  }

  li {
    text-transform: capitalize;
    word-spacing: -0.5ch;
  }
</style>
