<style>
  p {
    max-width: 65ch;
    margin-inline: auto;
    margin-block: 2rem;
  }
  .certs-img-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-around;
    margin-block-start: 3rem;

    > img {
      @media (max-width: 500px) {
        width: 100%;
      }
    }

    img {
      display: block;
      max-width: 350px;
      height: auto;
      max-height: 100%;
    }
  }

  .codecademy-certs-outer-wrapper {
    position: relative;
    min-width: 0;
    max-width: 65%;

    @media (max-width: 600px) {
      max-width: 100%;
    }

  }
  .pseudo-anchor {
    position: absolute;
    inset: 0;
  }
  .pseudo-anchor::after {
    content: "";
    position: absolute;
    z-index: 998;
    pointer-events: none;
    inset: -0.5rem;

    background-image: url("/images/curtain-l-side.webp");
    background-size: 44rem 100%;
    background-repeat: no-repeat;
    
    /* using the equivalent bg image for the right side
      would not respond correctly as the screen got smaller,
      so i did a second left and flipped it, holy shit, it worked! */
    transform: scalex(-1);
    
  }

  .codecademy-certs-inner-wrapper {
    display: flex;
    gap: 0.5rem;
    overflow-x: scroll;
    position: relative;
    scroll-snap-type: x mandatory;
    max-width: 725px;
    border-radius: 25px 25px 45px 45px;

    .cc-image-wrapper {
      min-width: 300px;
      max-height: 260px;
      scroll-snap-align: center;
      padding-block-start: 0.5rem;

      img {
        max-width: 100%;
      }

      &:first-child {
        padding-inline-start: 2rem;
      }
      &:last-child {
        padding-inline-end: 2rem;
      }

      @media (max-width: 500px) {
        min-width: 225px;
        max-height: 195px;
      }
    }
  }

  .codecademy-certs-outer-wrapper::before {
    content: "";
    position: absolute;
    z-index: 999;
    pointer-events: none;
    background-image: url("/images/curtain-top.webp");
    inset: -0.5rem;
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  .codecademy-certs-outer-wrapper::after {
    content: "";
    position: absolute;
    z-index: 998;
    pointer-events: none;
    inset: -0.5rem;

    background-image: url("/images/curtain-l-side.webp");
    background-size: 44rem 100%;
    background-repeat: no-repeat;

    
  }
</style>
