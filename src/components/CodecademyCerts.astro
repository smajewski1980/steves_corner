<style>
  .certs-img-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 2rem;

    & > * {
      flex: 1;
    }

    img {
      display: block;
      max-width: 450px;
      height: auto;
    }
  }

  .codecademy-certs-wrapper {
    display: flex;
    gap: 0.5rem;
    overflow-x: scroll;
    outline: 1px solid var(--text-color-700);
    padding: 0.5rem;
    position: relative;

    .cc-image-wrapper {
      min-width: 300px;
    }

    img {
      display: block;
      max-width: 100%;
    }

    &::after {
      content: "";
      position: sticky;
      right: 0;
      display: block;
      height: 100%;
      width: 100%;
      background-image: linear-gradient(
        to right,
        transparent 0%,
        transparent 50%,
        hsla(0deg 0% 0% / 0.3) 100%
      );
    }
  }
</style>
