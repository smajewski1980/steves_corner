<style>
  .certs-img-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;

    > img {
      @media (max-width: 500px) {
        width: 100%;
      }
    }

    img {
      display: block;
      max-width: 350px;
      height: auto;
      max-height: 100%;
    }
  }

  .codecademy-certs-outer-wrapper {
    position: relative;
    /* flex: 1; */
    min-width: 0;
    max-width: 65%;

    @media (max-width: 600px) {
      max-width: 100%;
    }
  }

  .codecademy-certs-inner-wrapper {
    display: flex;
    gap: 0.5rem;
    overflow-x: scroll;
    position: relative;
    scroll-snap-type: x mandatory;
    min-width: 350px;
    max-width: 725px;
    border-radius: 25px 25px 45px 45px;

    @media (max-width: 500px) {
      border-radius: 0;
      min-width: calc(100% + 1rem);
    }

    .cc-image-wrapper {
      min-width: 300px;
      max-height: 260px;
      scroll-snap-align: center;
      padding-block-start: 0.5rem;

      &:first-child {
        padding-inline-start: 2rem;
      }

      @media (max-width: 500px) {
        min-width: 225px;
        max-height: 195px;
      }
    }
  }

  .codecademy-certs-outer-wrapper::before {
    content: "";
    position: absolute;
    z-index: 99999;
    pointer-events: none;
  }

  .codecademy-certs-outer-wrapper::after {
    content: "";
    position: absolute;
    z-index: 9999;
    pointer-events: none;
    inset: -0.5rem;

    background-image: url("/images/test-curtain.webp");
    background-size: 100% 100%;
    background-repeat: no-repeat;

    /* border-image-source: url("/images/test-curtain.webp");
    border-image-slice: 62 62 fill;
    border-image-width: 5rem; */

    /* border: 60px solid; */
    /* border-image-repeat: round; */
    /* border-image-outset: 0rem; */
  }
</style>
