---
import { Image } from "astro:assets";
import fallbackImage from "../../public/placeholder.webp";
import closeIcon from "../../public/images/close-icon.webp";

const { src, alt, lightboxId } = Astro.props;
---

<button
  commandfor={lightboxId}
  command='show-modal'
  class='dialog-btn'
>
  <Image
    src={src || fallbackImage}
    alt={alt || ""}
    width='75'
    height='75'
  />
</button>

<dialog
  id={lightboxId}
  closedby='any'
>
  <Image
    src={src || fallbackImage}
    alt={alt || ""}
  />
  <button
    commandfor={lightboxId}
    command='close'
  >
    <Image
      src={closeIcon}
      alt='close'
      id="btn-lightbox-close-icon"
    />
  </button>
</dialog>

<!-- for browser support -->
<script>
  // Check if the browser natively supports invoker commands
  if (!Object.hasOwn(HTMLButtonElement.prototype, "commandfor")) {
    // Add a global listener for click events
    document.addEventListener("click", (event) => {
      const eventTarget = (event.target as Element) || null;

      const button = eventTarget.closest("[commandfor]");
      if (!button) return;

      const targetId = button.getAttribute("commandfor") as string;
      const action = button.getAttribute("command");
      const targetElement = document.getElementById(targetId);

      if (!targetElement) return;

      // Handle standard <dialog> commands
      if (targetElement instanceof HTMLDialogElement) {
        if (action === "show-modal") {
          targetElement.showModal();
        } else if (action === "close") {
          targetElement.close();
        }
      }
    });
  }
</script>

<style>
  button {
    cursor: pointer;
  }

  .dialog-btn {
    filter: contrast(200%) brightness(250%) blur(5px);
    animation: thumbnailLoadIn 0.75s 0.5s ease forwards;
    position: relative;
  }

  .dialog-btn::after {
    content: "";
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    transform-origin: center;
    width: 150px;
    height: 150px;
    opacity: 0.5;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0) 40%,
      hsl(from var(--text-color-700) h s l / 0.65) 65%,
      rgba(255, 255, 255, 0) 80%
    );
    filter: blur(6px);
    z-index: 999;
    animation: smoke-ring 0.75s;
    animation-delay: 0.85s;
  }

  dialog {
    margin: auto;
    background-color: hsl(from var(--text-color-700) h s calc(l - 20) / 0.6);
    outline: 1px solid var(--text-color-100);
    box-shadow: 0 0 20px var(--text-color-100);
    border-radius: 5px;
    overflow: visible;

    img:not(button img) {
      outline: 2px solid var(--text-color-100);
      box-shadow: 0 0 10px var(--text-color-100);
      filter: drop-shadow(0 0 10px var(--text-color-100));
      max-width: 100%;
      width: auto;
      height: auto;
      max-height: 85dvh;
      display: block;
    }

    &::backdrop {
      background-color: hsl(from var(--text-color-700) h s calc(l - 20) / 0.6);

    }

    button {
      position: absolute;
      top: 0rem;
      right: 0rem;
      background-color: transparent;
      border: none;
      border-radius: 5px;
      max-width: 48px;
      max-height: 48px;
      
      /* prevent the stupid blue outline on the ipad */
      outline: none;
    }

    #btn-lightbox-close-icon {
      width: 75%;
      height: 75%;
      display: block;
      margin: .25rem .25rem 1.25rem 0;
      outline: 1px solid chartreuse;
      padding: .25rem;
      background-color: hsl(from var(--text-color-700) h s calc(l - 20) / 0.8);
      outline: 1px solid var(--text-color-100);
      box-shadow: 0 0 20px var(--text-color-100);
    }
  }

  @media (max-width: 800px) {
    dialog {
      margin-inline: 0.5rem;
    }

    dialog button {
      top: -2.25rem;
      right: -.5rem;
    }

    dialog #btn-lightbox-close-icon {
      background-color: hsl(from var(--text-color-700) h s calc(l - 20) / 0.5);
    }
  }
</style>
