---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Tags from "./Tags.astro";

const allMusicItems: CollectionEntry<"music">[] = await getCollection("music");
const tags: string[] = allMusicItems.flatMap((item) => item.data.tags);
const uniqueTags: string[] = [...new Set(tags)].sort();
---

<h4>Search by tag:</h4>
<Tags tags={uniqueTags} />

<style>
  h4 {
    margin-block-start: 2rem;
  }
</style>
