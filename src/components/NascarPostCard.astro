---
import { formatDate } from "../utils";
import type { CollectionEntry } from "astro:content";
import Tags from "./Tags.astro";
import { Image } from "astro:assets";

const { post } = Astro.props;

interface Props {
  post: CollectionEntry<"nascar">;
}
---

<div class='nascar-card-wrapper'>
  <div class='nascar-card-inner-wrapper'>
    <a href={"/nascar/" + post.id}>
      <Image
        src={post.data.mainImage}
        alt='Article Image'
      />
    </a>
    <div class='nascar-card-inner-wrapper-bottom'>
      <h2>
        <a href={"/nascar/" + post.id}>{post.data.raceTitle}</a>
      </h2>
      <p>
        {formatDate(post.data.raceDate)}
      </p>
      <Tags tags={post.data.tags} />
    </div>
  </div>
</div>

<style>
  .nascar-card-wrapper {
    max-width: 28rem;
    margin-inline: auto;
    margin-top: 2.5rem;
    background-color: white;
    box-shadow:
      0 10px 15px -3px hsl(from var(--text-color-700) h s l / 0.1),
      0 4px 6px -4px hsl(from var(--text-color-700) h s l / 0.1);

    .nascar-card-inner-wrapper {
      border-radius: 10px;
      overflow: hidden;

      a {
        &:hover {
          opacity: 0.75;
        }

        img {
          width: 100%;
          height: 12rem;
          object-fit: contain;
          transition: 0.3s ease-in-out;
        }
      }

      .nascar-card-inner-wrapper-bottom {
        padding: 1.25rem;

        h2 {
          font-weight: 600;
          font-size: 1.5rem;
          margin-block-end: 0.5rem;
        }

        p {
          font-size: 0.85rem;
          margin-block-end: 0.75rem;
        }
      }
    }
  }
</style>
