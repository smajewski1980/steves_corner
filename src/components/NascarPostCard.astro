---
import { formatDate } from "../utils";
import type { CollectionEntry } from "astro:content";
import Tags from "./Tags.astro";
import { Image } from "astro:assets";

const { post } = Astro.props;

interface Props {
  post: CollectionEntry<"nascar">;
}
---

<div class='nascar-card-wrapper card-shadow'>
  <div class='nascar-card-inner-wrapper'>
    <a href={"/nascar/" + post.id.replace(/\/index\.(mdx|md)$/, "")}>
      <div class='image-wrapper'>
        <Image
          src={post.data.mainImage}
          alt='Article Image'
        />
      </div>
    </a>
    <div class='nascar-card-inner-wrapper-bottom'>
      <h2>
        <a href={"/nascar/" + post.id}>{post.data.raceTitle}</a>
      </h2>
      <p>
        {formatDate(post.data.raceDate)}
      </p>
      <Tags
        tags={post.data.tags}
        isCard={true}
      />
    </div>
  </div>
</div>

<style>
  .nascar-card-wrapper {
    display: grid;
    justify-content: space-between;
    max-width: 28rem;
    margin-inline: auto;
    margin-top: 2.5rem;
    background-color: white;
    border-radius: 0px 0px 10px 10px;
    outline: 1px solid var(--text-color-700);
    padding-block-end: 1rem;

    .nascar-card-inner-wrapper {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;

      .image-wrapper {
        display: grid;
        place-content: center;
        min-height: 175px;

        @media (min-width: 768px) {
          min-height: 200px;
        }
      }

      a {
        text-underline-offset: 5px;

        &:hover {
          opacity: 0.75;
        }

        img {
          width: 100%;
          height: auto;
          object-fit: contain;
          transition: 0.3s ease-in-out;
        }
      }

      .nascar-card-inner-wrapper-bottom {
        padding-inline: 1.25rem;
        display: grid;
        grid-template-rows: auto 1fr auto;
        flex: 1;

        h2 {
          font-weight: 600;
          font-size: clamp(1.25rem, 0.269vw + 1.156rem, 1.5rem);
          margin-block-end: 0.5rem;
          line-height: 1.3;
          margin-block: 0.25rem;
          text-wrap: balance;
        }

        p {
          font-size: 0.85rem;
        }
      }
    }
  }
</style>
