---
import { formatDate } from "../utils";
import type { CollectionEntry } from "astro:content";
import Tags from "./Tags.astro";
import { Image } from "astro:assets";
import testImage from "../images/nascar/5-31-2014_dover.webp";

const { post } = Astro.props;

interface Props {
  post: CollectionEntry<"nascar">;
}
---

<div class='max-w-md mx-auto mt-10'>
  <div class='bg-white rounded-lg overflow-hidden shadow-lg'>
    <a href={"/nascar/" + post.id}>
      <Image
        src={testImage}
        alt='Article Image'
        class='w-full h-48 object-cover hover:opacity-75 transition duration-300 ease-in-out'
      />
    </a>
    <div class='p-6'>
      <h2 class='text-2xl font-semibold mb-2'>
        <a href={"/nascar/" + post.id}>{post.data.raceTitle}</a>
      </h2>
      <p class='text-gray-600 text-sm mb-4'>
        {formatDate(post.data.raceDate)}
      </p>
      <Tags tags={post.data.tags} />
    </div>
  </div>
</div>
