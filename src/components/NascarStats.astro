---
import type { CollectionEntry } from "astro:content";
import { countStrings } from "../utils";
import ExternalLinkIcon from "../../public/external-link-svg.svg";
import { Image } from "astro:assets";
import racecarSteve from "../images/racecar_steve.webp";

interface Props {
  posts: CollectionEntry<"nascar">[];
}

const { posts } = Astro.props;

// this setup ensures the order of the tags doesnt matter

// the valid series strings
const seriesKeywords = ["cup-series", "xfinity-series", "truck-series"];
// loop through the posts and grab the tag that is a number (the year)
const allYears = posts.map(
  (post) =>
    post.data.tags.find((tag) => /^\d{4}$/.test(tag?.trim())) || "Unknown Year",
);
// compare the tags to the series array, get the matching ones
const allSeries = posts.map(
  (post) =>
    post.data.tags.find((tag) =>
      // does the tag name match any of the series names
      seriesKeywords.some((k) => tag?.toLowerCase().includes(k)),
    ) || "Unknown Series",
);
// the valid tracks
const trackKeywords = ["dover", "loudon", "pocono", "watkins-glen", "richmond"];
// compare the tags to the tracks array, get the matching ones
const allTracks = posts.map(
  (post) =>
    post.data.tags.find((tag) =>
      // does the tag name match any of the track names
      trackKeywords.some((k) => tag?.toLowerCase().includes(k)),
    ) || "Unknown Track",
);
// get all the drivers names
const allDrivers = posts.map(
  (post) =>
    post.data.tags.find(
      (tag) =>
        // if its not a date, not a series or a track, it must be a driver
        !/^\d{4}$/.test(tag?.trim()) &&
        !seriesKeywords.some((k) => tag?.toLowerCase().includes(k)) &&
        !trackKeywords.some((k) => tag?.toLowerCase().includes(k)),
    ) || "Unknown Driver",
);

const countedDrivers = Object.entries(countStrings(allDrivers));
const countedYears = Object.entries(countStrings(allYears));
const countedTracks = Object.entries(countStrings(allTracks));
const countedSeries = Object.entries(countStrings(allSeries));

const countedDriversSorted = countedDrivers.toSorted((a, b) => b[1] - a[1]);
const countedYearsSorted = countedYears.toSorted((a, b) => b[1] - a[1]);
const countedTracksSorted = countedTracks.toSorted((a, b) => b[1] - a[1]);
const countedSeriesSorted = countedSeries.toSorted((a, b) => b[1] - a[1]);
---

<section>
  <p class='weatherWeRace'>
    I wanted to be able, with one click, to see the upcoming race weather in one
    place for all three series. So I threw together <a
      class='weather-link'
      href='https://weatherwerace.com'
      target='_blank'
      >weatherwerace.com</a
    ><span class='icon-wrapper'
      ><ExternalLinkIcon
        width='16px'
        height='16px'
      /></span
    > to do just that.
  </p>
  <aside>
    <div class='stats-wrapper form-shadow'>
      <h3>STATS:</h3>

      <details class='details-series-tally'>
        <summary>Total Races Attended By Series</summary>
        <p>
          {
            countedSeriesSorted.map((s) => (
              <span class='series-tally'>
                {s[0].split("-")[0].replace("xfinity", "o'Reilly")}: {s[1]}
              </span>
            ))
          }
        </p>
      </details>

      <details class='details-track-tally'>
        <summary>Total Races Attended By Track (incl. all series)</summary>

        <p>
          {
            countedTracksSorted.map((s) => (
              <span class='track-tally'>
                {s[0]}: {s[1]}
              </span>
            ))
          }
        </p>
      </details>

      <details class='details-year-tally'>
        <summary>Total Races Attended By Year(incl. all series)</summary>
        <p>
          {
            countedYearsSorted.map((s) => (
              <span class='year-tally'>
                {s[0]}: {s[1]}&nbsp;&nbsp; &nbsp;{" "}
              </span>
            ))
          }
        </p>
      </details>

      <details class='details-driver-tally'>
        <summary>Total Races Attended By Winning Driver</summary>
        <p>
          {
            countedDriversSorted.map((s) => (
              <span>
                {s[0].replaceAll("-", " ")}: {s[1]}
              </span>
            ))
          }
        </p>
      </details>
    </div>
    <div class='image-wrapper'>
      <Image
        src={racecarSteve}
        alt="A doctored pic of Cartoon Steve driving Denny Hamlin's racecar."
      />
    </div>
  </aside>
</section>

<script>
  const seriesDetails = document.querySelector(".details-series-tally");
  const trackDetails = document.querySelector(".details-track-tally");
  const yearDetails = document.querySelector(".details-year-tally");
  const driverDetails = document.querySelector(".details-driver-tally");
  const seriesPara = seriesDetails?.querySelector("p");
  const trackPara = trackDetails?.querySelector("p");
  const yearPara = yearDetails?.querySelector("p");
  const driverPara = driverDetails?.querySelector("p");

  const statElems = [
    [seriesDetails, seriesPara],
    [trackDetails, trackPara],
    [yearDetails, yearPara],
    [driverDetails, driverPara],
  ];

  statElems.forEach((elems) => {
    elems[0]?.addEventListener("toggle", (e) => {
      const target = e.target as HTMLDetailsElement;

      if (target.open) {
        elems[1]?.classList.add("slide-in");
      }
    });
  });
</script>

<style>
  section {
    margin-inline: auto;
    padding-inline: 1rem;
  }
  /* get the checkered flag icon from weatherwerace.com for the details carats */
  .weatherWeRace {
    margin-block-end: 2rem;
  }

  aside {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  .image-wrapper {
    max-width: 500px;
    align-self: start;
    border-radius: 10px;
    overflow: hidden;

    @media (max-width: 768px) {
      max-width: calc(100dvw - 2rem);
    }

    img {
      max-width: 100%;
      height: auto;
    }
  }

  .stats-wrapper {
    padding: 1rem;
    outline: 1px solid var(--text-color-700);
    align-self: center;
    overflow: hidden;

    h3,
    details:not(:last-child) {
      margin-block-end: 1rem;
    }

    details {
      max-width: fit-content;

      summary {
        font-weight: 600;
        margin-block-end: 0.25rem;
        list-style-type: none;
      }

      summary::before {
        content: "";
        display: inline-block;
        width: 16px;
        height: 16px;
        margin-inline-end: 0.5rem;
        vertical-align: middle;
        background-image: url("/images/checkered.png");
        background-repeat: no-repeat;
        background-size: contain;
        transform: rotate(-45deg) translateY(-50%);
        transform-origin: 100% 50%;
        clip-path: polygon(100% 0%, 100% 100%, 0% 100%, 100% 0%);
        transition:
          transform 0.2s ease,
          clip-path 0.2s ease;
      }

      @media (max-width: 768px) {
        max-width: calc(100dvw - 4rem);
      }
    }

    details[open] summary::before {
      transform: rotate(45deg);
    }

    details p {
      text-transform: capitalize;
    }

    .details-series-tally p {
      display: flex;
      justify-content: space-between;
      transform: translateX(-25rem);
      filter: blur(2px);
    }

    .details-track-tally p {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      transform: translateX(30rem);
      filter: blur(2px);

      @media (min-width: 768px) {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .details-year-tally p {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 10ch), 1fr));
      margin-block-start: 0.75rem;
      transform: translateX(-25rem);
      filter: blur(2px);

      @media (max-width: 768px) {
        line-height: 1;
      }
    }

    .details-driver-tally p {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      column-gap: 4rem;
      transform: translateX(30rem);
      filter: blur(2px);

      @media (max-width: 768px) {
        grid-template-columns: 1fr;
      }
    }

    .track-tally {
      white-space: nowrap;
    }
  }

  span.icon-wrapper {
    margin-inline-start: 0.2rem;
  }

  a.weather-link {
    font-size: 1.125rem;
    font-style: italic;
  }

  .slide-in {
    animation: slide-in 0.3s 0.1s ease-out forwards;
  }

  @keyframes slide-in {
    to {
      transform: translateX(0);
      filter: blur(0);
    }
  }

  @media (min-width: 768px) {
    @keyframes slide-in {
      to {
        transform: translateX(1rem);
        filter: blur(0);
      }
    }
  }
</style>
