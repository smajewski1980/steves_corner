---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { countStrings } from "../utils";
import ExternalLinkIcon from "../../public/external-link-svg.svg";

const allNascarPosts: CollectionEntry<"nascar">[] =
  await getCollection("nascar");

const allDrivers = allNascarPosts.map((post) => post.data.tags[0]);
const allYears = allNascarPosts.map((post) => post.data.tags[1]);
const allTracks = allNascarPosts.map((post) => post.data.tags[2]);
const allSeries = allNascarPosts.map((post) => post.data.tags[3]);

const countedDrivers = Object.entries(countStrings(allDrivers));
const countedYears = Object.entries(countStrings(allYears));
const countedTracks = Object.entries(countStrings(allTracks));
const countedSeries = Object.entries(countStrings(allSeries));

const countedDriversSorted = countedDrivers.sort((a, b) => b[1] - a[1]);
const countedYearsSorted = countedYears.sort((a, b) => b[1] - a[1]);
const countedTracksSorted = countedTracks.sort((a, b) => b[1] - a[1]);
const countedSeriesSorted = countedSeries.sort((a, b) => b[1] - a[1]);
---

<section class='stats-wrapper'>
  <p>
    I wanted to be able, with one click, to see the upcoming race weather in one
    place for all three series. So I threw together <a
      class='weather-link'
      href='https://weatherwerace.com'
      target='_blank'
      >weatherwerace.com</a
    ><span class='icon-wrapper'
      ><ExternalLinkIcon
        width='16px'
        height='16px'
      /></span
    > to do just that.
  </p>
  <br />
  <h3>STATS:</h3>
  <h4>Total Races Attended by series:</h4>
  <p>
    {
      countedSeriesSorted.map((s) => (
        <span>
          {s[0]}: {s[1]}&nbsp;&nbsp; &nbsp;{" "}
        </span>
      ))
    }
  </p>
  <br />
  <h4>Total Races Attended by track(including all series):</h4>
  <p>
    {
      countedTracksSorted.map((s) => (
        <span>
          {s[0]}: {s[1]}&nbsp;&nbsp; &nbsp;{" "}
        </span>
      ))
    }
  </p>
  <br />
  <h4>Total Races Attended by year(including all series):</h4>
  <p>
    {
      countedYearsSorted.map((s) => (
        <span>
          {s[0]}: {s[1]}&nbsp;&nbsp; &nbsp;{" "}
        </span>
      ))
    }
  </p>
  <br />
  <h4>Total Races Attended by driver who won:</h4>
  <p>
    {
      countedDriversSorted.map((s) => (
        <span>
          {s[0]}: {s[1]}&nbsp;&nbsp; &nbsp;{" "}
        </span>
      ))
    }
  </p>
</section>

<style>
  span {
    display: inline-block;
  }

  span.icon-wrapper {
    margin-inline-start: 0.2rem;
  }

  a.weather-link {
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 1.125rem;
    font-style: italic;
  }
</style>
