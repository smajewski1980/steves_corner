---
import { Image } from "astro:assets";
import logo from "../images/steves-corner-logo.webp";
---

<nav>
  <a href='/'>
    <Image
      src={logo}
      alt='TechPeople Logo'
      width='150'
    />
  </a>
  <button
    data-collapse-toggle='navbar-default'
    type='button'
    class='hamburger'
    aria-controls='navbar-default'
    aria-expanded='false'
  >
    <span class='screen-reader-only'>Open main menu</span>
    <svg
      aria-hidden='true'
      xmlns='http://www.w3.org/2000/svg'
      fill='none'
      viewBox='0 0 17 14'
    >
      <path
        stroke='currentColor'
        stroke-linecap='round'
        stroke-linejoin='round'
        stroke-width='2'
        d='M1 1h15M1 7h15M1 13h15'
      ></path>
    </svg>
  </button>
  <div
    class='my-hidden'
    id='navbar-default'
  >
    <ul>
      <li>
        <a
          href={"/"}
          aria-current='page'
          >Home</a
        >
      </li>
      <li>
        <a href={"/articles/"}>Music Posts</a>
      </li>
      <li>
        <a href={"/nascar/"}>Nascar Posts</a>
      </li>
      <li>
        <a href={"/about/"}>About</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const hamburger = document.querySelector(".hamburger");
  const menu = document.getElementById("navbar-default");

  hamburger?.addEventListener("click", () => {
    menu?.classList.toggle("is-open");
  });
</script>

<style>
  nav {
    padding: 1rem 3.5rem;
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;

    button {
      color: var(--text-color-400);
      justify-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 10px;

      &:focus {
        outline: none;
        box-shadow: 0 0 0 2px var(--text-color-400);
      }

      svg {
        width: 1.25rem;
        height: 1.25rem;
      }
    }

    .my-hidden {
      display: none;
    }

    .is-open {
      display: block;
    }

    #navbar-default {
      width: 100%;
    }

    @media (min-width: 768px) {
      .hamburger {
        display: none;
      }

      #navbar-default {
        display: block;
        width: auto;
      }
    }

    ul {
      display: flex;
      flex-direction: column;
      padding: 1rem;
      margin-block-start: 1rem;
      font-weight: 500;
      border: 2px solid var(--text-color-400);
      border-radius: 10px;
      gap: 1rem;

      @media (min-width: 768px) {
        flex-direction: row;
        padding: 0;
        margin-block-start: 0;
        border: 0;
        gap: 2rem;
      }

      li a {
        color: var(--text-color-400);
        display: block;
        padding: 0.5rem 1rem;
        border-radius: 5px;

        &:hover {
          outline: 2px solid currentColor;
          outline-offset: 5px;
        }

        @media (min-width: 768px) {
          padding: 0;
        }
      }
    }
  }
</style>
