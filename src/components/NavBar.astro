---
import { Image } from "astro:assets";
import logo from "../images/steves-corner-logo.webp";
---

<header id='main-header'>
  <nav>
    <a href='/'>
      <Image
        src={logo}
        alt='Steves Corner Logo'
        width='125'
      />
    </a>
    <button
      data-collapse-toggle='navbar-default'
      type='button'
      class='hamburger card-shadow'
      aria-controls='navbar-default'
      aria-expanded='false'
    >
      <span class='screen-reader-only'>Open main menu</span>
      <svg
        aria-hidden='true'
        xmlns='http://www.w3.org/2000/svg'
        fill='none'
        viewBox='0 0 17 14'
      >
        <path
          stroke='currentColor'
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M1 1h15M1 7h15M1 13h15'
        ></path>
      </svg>
    </button>
    <div
      class='my-hidden'
      id='navbar-default'
    >
      <ul class='form-shadow'>
        <li class='form-shadow'>
          <a href={"/about/"}><span>About Steve</span></a>
        </li>
        <li class='form-shadow'>
          <a href={"/coding/"}><span>Coding</span></a>
        </li>
        <li class='form-shadow'>
          <a href={"/music/1"}><span>Music</span></a>
        </li>
        <li class='form-shadow'>
          <a href={"/nascar/"}><span>Nascar</span></a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const hamburger = document.querySelector(".hamburger");
  const menu = document.getElementById("navbar-default");

  hamburger?.addEventListener("click", () => {
    menu?.classList.toggle("is-open");
  });

  // make the header go away on scroll down
  // and come back when scrolled up
  let lastScrollY = window.scrollY;
  const header = document.getElementById("main-header");

  window.addEventListener("scroll", () => {
    const currentScrollY = window.scrollY;

    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      // Scrolling DOWN - Hide the header
      header?.classList.add("header-hidden");
    } else {
      // Scrolling UP - Show the header
      header?.classList.remove("header-hidden");
    }

    // Update the last scroll position
    lastScrollY = currentScrollY;
  });
</script>

<style>
  #main-header {
    position: fixed;
    top: 0;
    left: 0;
    padding-block-start: 0.5rem;
    width: 100%;
    z-index: 9999;
    transition: transform 1s;
    transition-timing-function: linear(
      0,
      0.009 0.6%,
      0.039 1.3%,
      0.162 2.8%,
      0.826 8%,
      1.055 10.2%,
      1.2 12.4%,
      1.24 13.5%,
      1.259 14.6%,
      1.258 16.1%,
      1.227 17.8%,
      1.042 23.4%,
      0.981 25.7%,
      0.947 27.7%,
      0.932 29.7%,
      0.937 32.6%,
      1.001 40.3%,
      1.018 44.9%,
      0.995 59.9%,
      1
    );
    background-color: var(--footer-header-bg);
    border-bottom: 1px solid var(--text-color-700);
  }

  .header-hidden {
    transform: translateY(-110%);
  }

  nav {
    padding: 1rem;
    max-width: var(--max-width);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;

    button {
      color: var(--text-color-400);
      border-radius: 10px;
      justify-items: center;
      width: 2.5rem;
      height: 2.5rem;

      &:focus {
        outline: none;
        box-shadow: 0 0 0 2px var(--text-color-400);
      }

      svg {
        width: 1.25rem;
        height: 1.25rem;
      }
    }

    .my-hidden {
      display: none;
    }

    .is-open {
      display: block;
    }

    #navbar-default {
      width: 100%;
    }

    @media (min-width: 768px) {
      .hamburger {
        display: none;
      }

      #navbar-default {
        display: block;
        width: auto;
      }

      img {
        margin-inline-start: 2rem;
      }
    }

    ul {
      display: flex;
      flex-direction: column;
      padding: 1rem;
      margin-block-start: 1rem;
      font-weight: 500;
      border: 2px solid var(--text-color-400);
      border-radius: 5px;
      gap: 1rem;

      @media (min-width: 768px) {
        flex-direction: row;
        padding: 0;
        margin-block-start: 0;
        margin-inline-end: 2rem;
        border: 0;
        gap: 2.5rem;
        box-shadow: none;
      }

      li {
        --shadow-offset: 2px;
        transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border-radius: 5px;
        &:hover,
        &:focus-visible {
          box-shadow: none;
          transform: translate(-2px, 2px);
        }
      }

      li a {
        color: var(--text-color-400);
        display: block;
        padding: 0.5rem 1rem;
        border-radius: 5px;
        outline: 1px solid var(--text-color-700);
        outline-offset: -1px;
        transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid var(--text-color-700);
        text-decoration: none;

        &:focus-visible {
          outline-offset: 5px;
          color: var(--text-color-700);
        }

        &:hover span {
          display: inline-block;
          transform: scale(0.97);
        }

        &:hover {
          border-color: transparent;
        }

        @media (min-width: 768px) {
          padding: 0.5rem 1rem;
        }
      }
    }
  }

  .hamburger {
    border: 1px solid var(--text-color-700);
  }

  ul li:first-child a {
    word-spacing: -3px;
  }
</style>
