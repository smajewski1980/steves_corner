---
const { prevUrl, nextUrl, currentPageRange, currentPage, lastPage } =
  Astro.props;

interface CurrentPageRange {
  high: string;
  low: string;
}

interface Props {
  prevUrl: string | undefined;
  nextUrl: string | undefined;
  currentPageRange: CurrentPageRange | undefined;
  currentPage: number;
  lastPage?: number | undefined;
}
---

<div class='pagination-wrapper'>
  <a
    href={prevUrl}
    class='form-shadow pag-link'
  >
    Previous
  </a>
  {
    currentPageRange ? (
      <p>
        {currentPageRange?.high} - {currentPageRange?.low}
      </p>
    ) : (
      `Page ${currentPage} of ${lastPage ? lastPage.toString() : "1"}`
    )
  }
  <a
    href={nextUrl}
    class='form-shadow pag-link'
  >
    Next
  </a>
</div>

<style>
  .pagination-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-start: 2.5rem;
    flex-direction: column;
    gap: 1rem;

    @media (min-width: 650px) {
      flex-direction: row;
      gap: 0;
    }

    a.pag-link {
      color: var(--text-color-700);
      background-color: var(--footer-header-bg);
      border-radius: 5px;
      text-align: center;
      padding: 1rem 0.75rem;
      min-width: 125px;
      width: calc(100% - 2rem);
      text-decoration: none;
      border: 1px solid var(--text-color-700);
      outline: 1px solid var(--text-color-700);
      outline-offset: -1px;
      transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);

      &:hover,
      &:focus-visible {
        box-shadow: none;
        transform: translate(-2px, 2px);
      }

      &:focus-visible {
        outline-offset: 5px;
      }

      @media (min-width: 650px) {
        width: fit-content;
        padding: 0.75rem;
      }
    }

    /* a[href]:hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    } */

    a[href]:focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 5px;
    }

    a:not([href]) {
      opacity: 0.4;
    }
  }
</style>
