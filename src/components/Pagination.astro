---
const { prevUrl, nextUrl, currentPageRange, currentPage } = Astro.props;

interface CurrentPageRange {
  high: string;
  low: string;
}

interface Props {
  prevUrl: string | undefined;
  nextUrl: string | undefined;
  currentPageRange: CurrentPageRange | undefined;
  currentPage: number;
}
---

<div class='pagination-wrapper'>
  <a href={prevUrl}> Previous </a>
  {
    currentPageRange ? (
      <p>
        {currentPageRange?.high} - {currentPageRange?.low}
      </p>
    ) : (
      `Page ${currentPage}`
    )
  }
  <a href={nextUrl}> Next </a>
</div>

<style>
  .pagination-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-start: 2.5rem;
    flex-direction: column;
    gap: 1rem;

    @media (min-width: 768px) {
      flex-direction: row;
      gap: 0;
    }

    a {
      color: var(--text-color-100);
      background-color: var(--text-color-700);
      border-radius: 10px;
      text-align: center;
      padding: 0.75rem;
      min-width: 125px;

      @media (min-width: 768px) {
        width: fit-content;
        min-width: 76px;
        padding: 0.5rem 0.75rem;
      }
      /* @media (max-width: 768px) {
        width: 300px;
      } */
    }

    a[href]:hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    }

    a[href]:focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 5px;
    }

    a:not([href]) {
      opacity: 0.4;
    }
  }
</style>
