---
import { formatDate } from "../utils";
const { prev, next, isNascarPost, isMusicBlog, animateSteve} = Astro.props;
---

{
  isNascarPost ? (
    <div class={animateSteve ? 'prev-next-links-wrapper animate-steve' : 'prev-next-links-wrapper'}>
      <div>
        {prev && (
            <span>Previous: </span>
          <a href={`/nascar/${prev.id.replace("index", "")}`}>
            {`${prev.data.raceTitle} ${formatDate(prev.data.raceDate)}`}
          </a>
        )}
      </div>
      <div>
        {next && (
            <span>Next: </span>
          <a href={`/nascar/${next.id.replace("index", "")}`}>
            {`${next.data.raceTitle} ${formatDate(next.data.raceDate)}`}
          </a>
        )}
      </div>
    </div>
  ) : (
    <div class={animateSteve ? 'prev-next-links-wrapper animate-steve' : 'prev-next-links-wrapper'}>
      <div>
        {prev && (
            <span>Previous: </span>
          <a href={`/music/${isMusicBlog ? "music-haul-blog/" : ""}${prev.id}`}>
            {`${prev.data.title}`}
          </a>
        )}
      </div>
      <div>
        {next && (
            <span>Next: </span>
          <a href={`/music/${isMusicBlog ? "music-haul-blog/" : ""}${next.id}`}>
            {`${next.data.title}`}
          </a>
        )}
      </div>
    </div>
  )
}

<style>
  .prev-next-links-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-block-end: 1rem;
    max-width: var(--max-width);
    margin-inline: auto;
    row-gap: 1rem;

    @media (max-width: 768px) {
      a {
        display: block;
        z-index: 99;
        position: relative;
      }
      
    }

    > * {
      --indent: 1rem;
      max-width: 47ch;
      padding-inline-start: var(--indent);
      text-indent: calc(var(--indent) * -1);
      line-height: 1.3;
    }

    span {
      font-size: 1.125rem;
      font-weight: 700;
    }
  }
    .animate-steve div:last-child span {
      --word-start-finish-angle: -39deg;
      --word-start-finish-mid-point-angle: -41deg;
      --hanging-steve-duration: 8s;
      rotate: var(--word-start-finish-angle);
      transform-origin: top right;
      display: inline-block;
      position: relative;
      z-index: 1;
      transform: translateY(-2rem);
      animation: hanging-steve-word 
      var(--hanging-steve-duration) linear infinite;
      
      @media (max-width: 768px) {    
        --word-start-finish-angle: 39deg;
        --word-start-finish-mid-point-angle: 41deg;
        --hanging-steve-duration: 5s;
        transform: translateY(0);
        transform-origin: top left;
        margin-block-end: 1rem;  
        margin-inline-start: 1.5rem;
      }
    }
    
    .animate-steve  div:last-child span::after {
      --start-finish-angle: 0deg;
      --mid-point-angle: -5deg;
      content: '';
      width: 75px;
      height: 85px;
      display: block;
      position: absolute;
      left: -5.25rem;
      bottom: -4rem;
      z-index: -1;
      transform-origin: top right;
      rotate: var(--start-finish-angle);
      animation: hanging-steve var(--hanging-steve-duration) ease-in-out infinite;
      background-image: url("../images/tiny-hanging-steve.webp");
      background-size: contain;
      background-repeat: no-repeat;

      @media (max-width: 768px) {
        --start-finish-angle: 2deg;
        --mid-point-angle: -1deg;
        transform: scaleX(-1);
        left: -3.25rem;
        bottom: -4rem;
        opacity: .6;
      }
    }
  

  @keyframes hanging-steve-word {
    from {
      rotate: var(--word-start-finish-angle);
    }

    50% {
      rotate: var(--word-start-finish-mid-point-angle);
    }

    to {
      rotate: var(--word-start-finish-angle);
    }

  }
  @keyframes hanging-steve {
    from {
      rotate: var(--start-finish-angle);
    }

    50% {
      rotate: var(--mid-point-angle);
    }

    to {
      rotate: var(--start-finish-angle);
    }
  }
</style>
