---
import { formatDate } from "../utils";
const { prev, next, isNascarPost, isMusicBlog } = Astro.props;
---

{
  isNascarPost ? (
    <div class='prev-next-links-wrapper'>
      <div>
        {prev && (
          <a
            href={`/nascar/${prev.id.replace("index", "")}`}
          >{`Previous: ${prev.data.raceTitle} ${formatDate(prev.data.raceDate)}`}</a>
        )}
      </div>
      <div>
        {next && (
          <a
            href={`/nascar/${next.id.replace("index", "")}`}
          >{`Next: ${next.data.raceTitle} ${formatDate(next.data.raceDate)}`}</a>
        )}
      </div>
    </div>
  ) : (
    <div class='prev-next-links-wrapper'>
      <div>
        {prev && (
          <a
            href={`/music/${isMusicBlog ? "music-haul-blog/" : ""}${prev.id}`}
          >{`Previous: ${prev.data.title}`}</a>
        )}
      </div>
      <div>
        {next && (
          <a
            href={`/music/${isMusicBlog ? "music-haul-blog/" : ""}${next.id}`}
          >{`Next: ${next.data.title}`}</a>
        )}
      </div>
    </div>
  )
}

<style>
  .prev-next-links-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-block-end: 1rem;
    max-width: var(--max-width);
    margin-inline: auto;
    row-gap: 1rem;

    > * {
      --indent: 1rem;
      max-width: 45ch;
      padding-inline-start: var(--indent);
      text-indent: calc(var(--indent) * -1);
      line-height: 1.3;
    }
  }
</style>
