---
import { formatDate } from "../utils";
const { prev, next, isNascarPost, isMusicBlog } = Astro.props;
---

{
  isNascarPost ? (
    <div class='prev-next-links-wrapper'>
      <div>
        {prev && (
            <span>Previous: </span>
          <a href={`/nascar/${prev.id.replace("index", "")}`}>
            {`${prev.data.raceTitle} ${formatDate(prev.data.raceDate)}`}
          </a>
        )}
      </div>
      <div>
        {next && (
            <span>Next: </span>
          <a href={`/nascar/${next.id.replace("index", "")}`}>
            {`${next.data.raceTitle} ${formatDate(next.data.raceDate)}`}
          </a>
        )}
      </div>
    </div>
  ) : (
    <div class='prev-next-links-wrapper'>
      <div>
        {prev && (
            <span>Previous: </span>
          <a href={`/music/${isMusicBlog ? "music-haul-blog/" : ""}${prev.id}`}>
            {`${prev.data.title}`}
          </a>
        )}
      </div>
      <div>
        {next && (
            <span>Next: </span>
          <a href={`/music/${isMusicBlog ? "music-haul-blog/" : ""}${next.id}`}>
            {`${next.data.title}`}
          </a>
        )}
      </div>
    </div>
  )
}

<style>
  .prev-next-links-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-block-end: 1rem;
    max-width: var(--max-width);
    margin-inline: auto;
    row-gap: 1rem;

    > * {
      --indent: 1rem;
      max-width: 45ch;
      padding-inline-start: var(--indent);
      text-indent: calc(var(--indent) * -1);
      line-height: 1.3;
    }

    span {
      font-size: 1.125rem;
      font-weight: 700;

    }
    /* & div:first-child span {
      rotate: -25deg;
      transform-origin: top left;
      display: inline-block;
    } */
    & div:last-child span {
      rotate: -35deg;
      transform-origin: top left;
      display: inline-block;
      position: relative;
      z-index: 1;
      animation: hanging-steve 5s ease-in-out infinite;
    }

    & div:last-child span::after {
      content: '';
      width: 75px;
      height: 85px;
      display: block;
      position: absolute;
      left: -5.25rem;
      bottom: -4rem;
      z-index: -1;
      background-image: url("../images/tiny-hanging-steve.webp");
      background-size: contain;
      background-repeat: no-repeat;
    }
  }

  @keyframes hanging-steve {
    from {
      rotate: -35deg;
    }

    50% {
      rotate: -40deg;
    }

    to {
      rotate: -35deg;
    }
  }
</style>
