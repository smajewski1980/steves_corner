---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts: CollectionEntry<"music">[] = await getCollection("music");
const postIds: object[] = posts.map((p) => {
  return {
    id: p.id,
    title: p.data.title,
  };
});
---

<form id='search-form'>
  <label
    for='query'
    class='screen-reader-only'
    >Search</label
  >
  <button
    type='submit'
    class='form-shadow'
  >
    <svg
      width='16'
      height='16'
      aria-hidden='true'
      xmlns='http://www.w3.org/2000/svg'
      fill='none'
      viewBox='0 0 20 20'
    >
      <path
        stroke='currentColor'
        stroke-linecap='round'
        stroke-linejoin='round'
        stroke-width='2'
        d='m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z'
      ></path>
    </svg>
    <span class='screen-reader-only'>Search</span>
  </button>
  <input
    type='text'
    id='query'
    class='form-shadow'
    name='query'
    placeholder='Search collection items...'
    autocomplete='off'
    required
  />
</form>

<script define:vars={{ postIds }}>
  // to filter the posts for a search, instead of getting all posts here to filter,
  // i just get the ids and titles which we then use to populate a select list
  //
  // if there are multiple posts for that term then redirect when
  // one is chosen or auto redirect if there is only one total

  const form = document.getElementById("search-form");
  let pickerIsOpen = false;
  let selectEl;
  const input = document.getElementById("query");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const searchTerm = input.value.trim().toLowerCase();
    // filter the postIds by the search term
    const filteredPostData = postIds.filter((postData) =>
      postData.title.toLowerCase().includes(searchTerm),
    );

    // if no posts, do nothing. later add toast
    if (!filteredPostData.length) return console.log("no results");

    // if only one choice, automatically redirect
    if (filteredPostData.length === 1) {
      window.location.href = `/music/${filteredPostData[0].id}`;
    } else {
      if (pickerIsOpen) return;
      pickerIsOpen = true;
      // create selectlist with to hold possible choices
      selectEl = document.createElement("select");
      selectEl.id = "search-dropdown";
      selectEl.classList.add("form-shadow");
      const placeholder = document.createElement("option");
      placeholder.textContent = "Choose an item...";
      placeholder.value = "";
      selectEl.appendChild(placeholder);
      // add to dom after the search input
      input.insertAdjacentElement("afterend", selectEl);
      // populate the options
      filteredPostData.forEach((data) => {
        const option = document.createElement("option");
        option.value = data.id;
        option.textContent = data.title;
        selectEl.appendChild(option);
      });
      // a value was the first option,
      // which wouldn't trigger a change if it was selected
      selectEl.value = "";
      selectEl.addEventListener("input", (e) => {
        if (!e.target.value) return;
        const slug = encodeURI(e.target.value);
        window.location.href = `/music/${slug}`;
      });
      selectEl.focus();
    }
  });

  // handle if the search term is changed before select option is chosen
  input.addEventListener("input", () => {
    if (!pickerIsOpen) {
      return;
    } else {
      selectEl.remove();
      pickerIsOpen = false;
    }
  });
</script>

<style>
  form {
    --shadow-offset: 2px;
    display: flex;
    align-items: center;
    margin-block-end: 1.5rem;
    color: var(--text-color-700);
    gap: 0.5rem;
    flex-wrap: wrap;
    row-gap: 1rem;
    justify-content: center;

    button {
      padding: 0.5rem;
      border-radius: 5px;
      transition: all 0.2s ease;
      display: grid;
      place-content: center;
      border: 1px solid var(--text-color-700);
      color: var(--text-color-700);
      cursor: pointer;
      margin-inline-end: 0.5rem;

      &:hover {
        background-color: var(--text-color-100);
        color: var(--text-color-700);
      }

      &:focus-visible {
        outline: 1px solid var(--text-color-700);
        outline-offset: 5px;
      }
    }
    #search-dropdown {
      padding: 0.5rem;
      outline: 0px solid var(--text-color-700);
      transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      margin-inline-start: 0.5rem;
      font: inherit;
      color: var(--text-color-700);
      border-radius: 5px;

      option {
        max-width: 50px;
      }

      @media (max-width: 500px) {
        & {
          width: 100%;
        }
      }

      &:focus-visible {
        outline: 2px solid var(--text-color-700);
        outline-offset: 8px;
      }
    }
  }

  #query {
    width: 100%;
    background-color: hsla(0, 0%, 97%);
    border: 1px solid currentColor;
    border-radius: 5px;
    padding: 0.5rem;
    transition: all 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    font: inherit;
    color: var(--text-color-700);
    flex: 1;

    @media (max-width: 500px) {
      & {
        width: auto;
      }
    }

    &::placeholder {
      color: var(--text-color-400);
      opacity: 0.8;
    }
  }

  #query:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 8px;
  }
</style>
