---
const { tags, isMusic } = Astro.props;

interface Props {
  tags: string[];
  isMusic?: boolean;
}
---

<div class={isMusic ? "tags-wrapper centered-tags" : "tags-wrapper"}>
  {
    tags.map((tag: string, idx: number) => (
      <span class={idx % 2 === 0 ? "tag" : "tag alternate-color"}>
        <a href={"/tag/" + tag}>{tag}</a>
      </span>
    ))
  }
</div>

<style>
  .tags-wrapper {
    --color-one: green;
    --color-two: indigo;

    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 1rem;
    color: var(--text-color-100);
    font-size: 0.875rem;
    align-self: end;

    .tag {
      background-color: var(--color-one);
      border-radius: 5px;
      padding: 0.3rem 0.4rem;
      transition: opacity 0.2s ease;

      &:hover {
        opacity: 0.8;
      }
    }

    .alternate-color {
      background-color: var(--color-two);
    }
  }
  .centered-tags {
    justify-content: center;
  }
</style>
