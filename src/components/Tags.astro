---
const { tags, isMusicCard, isMusicTags } = Astro.props;

interface Props {
  tags: string[];
  isMusicCard?: boolean;
  isMusicTags?: boolean;
}

tags.sort((a: string, b: string): number => {
  if (a.toLowerCase() > b.toLowerCase()) {
    return 1;
  } else {
    return -1;
  }
});
---

<div
  class={isMusicCard
    ? "tags-wrapper centered-tags"
    : isMusicTags
      ? "tags-wrapper music-tags"
      : "tags-wrapper"}
>
  {isMusicTags && <h4>Music Tags:</h4>}
  {
    tags.map((tag: string, idx: number) => (
      <span class={idx % 2 === 0 ? "tag" : "tag alternate-color"}>
        <a href={"/tag/" + tag}>{tag}</a>
      </span>
    ))
  }
</div>

<style>
  .tags-wrapper {
    --color-one: green;
    --color-two: indigo;

    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 1rem;
    color: var(--text-color-100);
    font-size: 0.875rem;
    align-self: end;

    .tag {
      background-color: var(--color-one);
      border-radius: 5px;
      padding: 0.3rem 0.4rem;
      transition: opacity 0.2s ease;

      &:hover {
        opacity: 0.8;
      }
    }

    .alternate-color {
      background-color: var(--color-two);
    }
  }
  .centered-tags {
    justify-content: center;
  }

  .music-tags {
    /* max-width: 500px; */
    gap: 0.75rem;
  }

  h4 {
    width: 100%;
    color: var(--text-color-700);
    margin-block-end: 0.75rem;
  }
</style>
