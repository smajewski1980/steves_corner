---
import type { CollectionEntry } from "astro:content";
import ImageLightbox from "./ImageLightbox.astro";

const { cd } = Astro.props;

interface Props {
  cd: CollectionEntry<"targetCds">;
}

const commonAltText = cd.data.title + " by " + cd.data.artist;
---

<article
  class=`target-cd-card-wrapper ${cd.data.manufacturedIn === "Japan" ? 'jpn' : cd.data.manufacturedIn.includes("Germany") ? 'wg' : 'other'}`
>
  <div class='image-wrapper'>
    <ImageLightbox
      src={cd.data.coverImage}
      alt={cd.data.coverImage ? "Image of the cover of " + commonAltText : ""}
      lightboxId={cd.id + "-cover"}
    />
    <ImageLightbox
      src={cd.data.discImage}
      alt={"Image of the target disc for " + commonAltText}
      lightboxId={cd.id + "-disc"}
    />
    <ImageLightbox
      src={cd.data.trayImage}
      alt={cd.data.trayImage
        ? "Image of the jewel case tray card for " + commonAltText
        : ""}
      lightboxId={cd.id + "-tray"}
    />
  </div>
  <div class='info-wrapper'>
    <p>{cd.data.artist} - {cd.data.title}</p>
    <p>Matrix: {cd.data.matrix}</p>
    <!-- <p>Origin: {cd.data.manufacturedIn}</p> -->
  </div>
</article>

<style>
  .target-cd-card-wrapper {
    outline: 1px solid var(--text-color-700);
    display: flex;

    gap: 0.5rem;
    padding: 0.5rem;
  }

  @media (max-width: 800px) {
    .target-cd-card-wrapper {
      flex-wrap: wrap;
    }
  }

  .target-cd-card-wrapper:first-child:not(:has(+ .target-cd-card-wrapper)) {
    max-width: 600px;
  }

  .image-wrapper {
    display: flex;
    gap: 0.25rem;
  }

  .info-wrapper {
    display: grid;
    place-content: center;
    --indent-size: 0.5rem;

    p {
      line-height: 1.2;
      text-indent: calc(var(--indent-size) * -1);
      padding-inline-start: var(--indent-size);
    }
  }

  .jpn {
    background-color: var(--jpn);
  }
  .wg {
    background-color: var(--wg);
  }
  .other {
    background-color: var(--other);
  }
</style>
