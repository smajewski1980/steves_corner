---
import { Image } from "astro:assets";
import logo from "../images/logo.png";
import { SITE_TITLE, SITE_DESCRIPTION } from "../constants";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
const { title = "Articles, Stories & Tutorials For Tech People" } = Astro.props;

// this started as a tutorial that is used Typescript
// its next on the list to learn

interface Props {
  title?: string;
}
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <meta
      name='description'
      content={SITE_DESCRIPTION}
    />

    <title>{SITE_TITLE} - {title}</title>
    <!-- Preload your local font file -->
    <!-- it was flashing user agent font then ours -->
    <link
      rel='preload'
      href='/fonts/OCRAEXT.TTF'
      as='font'
      type='font/ttf'
      crossorigin
    />
  </head>
  <body>
    <NavBar />
    <section>
      <slot />
    </section>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --primary-purple: hsl(300, 55%, 80%);
    --primary-purple-lower-opac: hsl(from var(--primary-purple) h s l / 0.6);
    --text-color-100: hsl(from var(--primary-purple) h s calc(l + 10));
    --text-color-400: hsl(from var(--primary-purple) h s calc(l - 35));
    --text-color-700: hsl(from var(--primary-purple) h s calc(l - 55));
    --max-width: 1280px;
    --med-width: 1024px;
    --main-font: "OCR A Extended";
    --asterisk: hsl(90, 100%, 45%);
    --heading-1-size: clamp(1.5rem, 1.0856rem + 1.768vw, 2.5rem);
    --jpn: hsla(0deg, 100%, 70%, 0.3);
    --wg: hsla(45deg, 100%, 70%, 0.4);
    --other: hsla(200deg, 70%, 60%, 0.3);
  }

  html {
    scroll-behavior: smooth;
    scroll-padding: 1rem;
  }

  @font-face {
    font-family: "OCR A Extended";
    src: url("/fonts/OCRAEXT.TTF");
  }

  *,
  *:after,
  *:before {
    margin: 0;
  }

  body {
    font-family: var(--main-font);
    margin: 0;
    padding: 8rem 0rem 1rem;
    min-height: 100dvh;
    color: var(--text-color-700);

    section {
      margin-inline: auto;
      margin-block-start: 2.5rem;
      max-width: var(--max-width);

      @media (min-width: 768px) {
        padding-inline: 2rem;
      }
    }

    .screen-reader-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ul {
      list-style-type: none;
    }
  }

  @media (max-width: 800px) {
    body {
      padding-inline: 1rem;
    }
  }

  .back-link {
    background-color: var(--text-color-700);
    border: 1px solid currentColor;
    border-radius: 10px;
    color: var(--text-color-100);
    cursor: pointer;
    font: inherit;
    outline: 1px solid var(--text-color-700);
    outline-offset: -3px;
    padding: 0.75rem 1.5rem;
    transition: all 0.2s ease;

    &:hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    }
    &:focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 2px;
    }
  }

  p {
    line-height: 1.6;
  }

  sup {
    padding-inline-start: 0.25rem;
  }

  @keyframes smoke-ring {
    50% {
      opacity: 1;
    }

    80 % {
      opacity: 0;
    }
    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.2);
    }
  }

  @keyframes thumbnailLoadIn {
    97% {
      filter: contrast(103%) brightness(103%) blur(1px) opacity(0.3);
    }
    to {
      filter: contrast(100%) brightness(100%) blur(0px) opacity(1);
    }
  }
</style>
