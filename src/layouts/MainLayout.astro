---
import { SITE_TITLE, SITE_DESCRIPTION } from "../constants";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/utilities.css";

const { title = "Steve's Corner Of The Internet" } = Astro.props;

interface Props {
  title?: string;
}
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <meta
      name='description'
      content={SITE_DESCRIPTION}
    />
    <link
      rel='icon'
      type='image/png'
      href='/favicon.png'
    />

    <title>{SITE_TITLE} - {title}</title>
    <!-- Preload your local font file -->
    <!-- it was flashing user agent font then ours -->
    <link
      rel='preload'
      href='/fonts/OCRAEXT.TTF'
      as='font'
      type='font/ttf'
      crossorigin
    />
    <script
      src='https://challenges.cloudflare.com/turnstile/v0/api.js'
      async
      defer
    ></script>
  </head>
  <body>
    <NavBar />
    <section id='stretch'>
      <slot />
    </section>
    <Footer />
  </body>
</html>
