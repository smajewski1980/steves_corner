---
import { Image } from "astro:assets";
import logo from "../images/logo.png";
import { SITE_TITLE, SITE_DESCRIPTION } from "../constants";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
const { title = "Articles, Stories & Tutorials For Tech People" } = Astro.props;

// this started as a tutorial that is used Typescript
// its next on the list to learn

interface Props {
  title?: string;
}
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <meta
      name='description'
      content={SITE_DESCRIPTION}
    />

    <title>{SITE_TITLE} - {title}</title>
    <!-- Preload your local font file -->
    <link
      rel='preload'
      href='/fonts/OCRAEXT.TTF'
      as='font'
      type='font/ttf'
      crossorigin
    />
  </head>
  <body>
    <NavBar />
    <section>
      <slot />
    </section>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --primary-purple: hsl(300, 55%, 80%);
    --primary-purple-lower-opac: hsl(from var(--primary-purple) h s l / 0.6);
    --text-color-100: hsl(from var(--primary-purple) h s calc(l + 10));
    --text-color-400: hsl(from var(--primary-purple) h s calc(l - 35));
    --text-color-700: hsl(from var(--primary-purple) h s calc(l - 55));
    --max-width: 1280px;
    --med-width: 1024px;
    --main-font: "OCR A Extended";
  }

  @font-face {
    font-family: "OCR A Extended";
    src: url("/fonts/OCRAEXT.TTF");
  }

  body {
    font-family: var(--main-font);
    margin: 0;
    padding: 1rem;
    background-image: linear-gradient(
      to bottom right,
      var(--primary-purple-lower-opac) 0%,
      transparent 35%,
      transparent 50%,
      var(--primary-purple-lower-opac) 100%
    );
    min-height: 100dvh;
    background-repeat: no-repeat;

    section {
      margin-inline: auto;
      margin-block-start: 2.5rem;
      max-width: var(--max-width);

      @media (min-width: 768px) {
        padding-inline: 2rem;
      }
    }

    .screen-reader-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    ul {
      list-style-type: none;
    }
  }
</style>
