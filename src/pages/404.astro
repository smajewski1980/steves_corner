---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
// import error from "../images/error-404.png";
import error from "../images/404_steve.webp";
---

<MainLayout>
  <div class='not-found-wrapper'>
    <Image
      src={error}
      alt='404 page not found'
      width='350'
      height='350'
    />
    <h1>Page Not Found</h1>
    <p>Sorry, page not found!</p>
    <a href='/'>There's No Place Like <span>HOME</span></a>
  </div>
</MainLayout>

<style>
  .not-found-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-items: center;
    gap: 1rem;
    color: var(--text-color-700);

    h1 {
      font-size: 3rem;
    }

    p {
      font-size: 1.5rem;
      margin-block-end: 1.5rem;
    }

    a {
      outline: 1px solid var(--text-color-700);
      background-color: hsl(from var(--text-color-100) h s calc(l + 5));
      border-radius: 10px;
      margin-block-end: 2rem;
      padding: 0.5rem;
      transition:
        color 0.15s ease,
        background-color 0.15s ease;
      display: flex;
      align-items: center;

      &:hover {
        color: hsl(from var(--text-color-100) h s calc(l + 5));
        background-color: var(--text-color-700);
      }
    }

    a span {
      font-weight: 700;
      font-size: 1.5rem;
      margin-inline-start: 0.25rem;
      margin-block-end: 0.1rem;
    }
  }
</style>
