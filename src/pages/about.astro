---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import about from "../images/about.jpg";
import codingImage from "../images/coding_image.webp";
import nascarImage from "../images/nascar_image.webp";
import team3 from "../images/team3.png";
---

<MainLayout title='About The Tech People Blog'>
  <section>
    <h1>About Steve's Corner of the Internet</h1>
    <div class='hero'>
      <div class='image-wrapper'>
        <Image
          src={about}
          alt='Tech People Team'
        />
      </div>

      <div class='hero-content-wrapper'>
        <!-- <h2>Who We Are</h2> -->
        <p>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Delectus sunt
          quibusdam, consequatur praesentium fuga aut soluta iusto tenetur eos
          neque libero cupiditate id quos veniam.
        </p>
        <p>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Tenetur quo
          repellendus nulla, minus sunt hic dolor optio fugiat voluptatum modi
          saepe quasi inventore architecto magni eligendi consectetur voluptates
          doloribus, id suscipit sapiente numquam perspiciatis quaerat sed
          rerum?
        </p>
      </div>
    </div>

    <!-- topics -->
    <div>
      <h2>Topics</h2>
      <div class='topics-wrapper'>
        <div class='topic-card'>
          <Image
            src={codingImage}
            alt='coding'
          />
          <div class='text-wrapper'>
            <h3>Coding</h3>
            <p>Things I've made</p>
          </div>
        </div>
        <div class='topic-card'>
          <Image
            src={team3}
            alt='physical music collection'
          />
          <div class='text-wrapper'>
            <h3>Music</h3>
            <p>A kick ass collection of physical media</p>
          </div>
        </div>
        <div class='topic-card'>
          <Image
            src={nascarImage}
            alt='nascar races'
          />
          <div class='text-wrapper'>
            <h3>NASCAR</h3>
            <p>Races I've been to</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  section {
    margin-inline: auto;
    max-width: var(--max-width);
    padding-inline: 2rem;
    margin-block-start: 2.5rem;
    color: var(--text-color-700);

    h1 {
      font-size: 2.5rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block: 1rem 2rem;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1rem;
  }

  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
    }
  }

  .image-wrapper {
    width: 100%;
    margin-bottom: 2rem;
    box-shadow:
      0 10px 15px -3px hsl(from var(--text-color-700) h s l / 0.1),
      0 4px 6px -4px hsl(from var(--text-color-700) h s l / 0.1);

    @media (min-width: 768px) {
      .image-wrapper {
        width: 50%;
        margin-bottom: 0rem;
      }
    }

    img {
      width: 100%;
      height: auto;
      border-radius: 10px;
    }
  }

  .hero-content-wrapper {
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-content-wrapper {
      width: 50%;
    }
  }

  h2 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-block-end: 1rem;
  }

  p {
    line-height: 1.65;
  }

  p:first-child {
    margin-block-end: 1.5rem;
  }

  .topics-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .topics-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .topics-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .topic-card {
    background-color: rgb(255 255 255);
    border-radius: 0.5rem; /* 8px */
    overflow: hidden;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);

    img {
      width: 100%;
      height: auto;
    }

    .text-wrapper {
      padding: 1.5rem;
    }

    h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-block-end: 0.5rem;
    }
  }
</style>
