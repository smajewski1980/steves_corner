---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import profilePic from "../images/profilePic_300x300.png";
import codingImage from "../images/coding_image.webp";
import musicImage from "../images/music_image.webp";
import nascarImage from "../images/nascar_image.webp";
---

<MainLayout>
  <section>
    <h1>About Steve</h1>
    <div class='hero'>
      <div class='hero-content-wrapper'>
        <p>
          I am a video production engineer for the New York State Assembly. I
          have been with them for over 13 years. I have met some cool people and
          seen some really interesting stuff around New York State. The historic
          capital building in Albany is such an awesome place to just wander
          around.
        </p>
        <p>
          I started to collect Cds when I was kid and it has turned into a
          collection of many thousands of pieces of physical media with lots of
          other items of memorabilia also. I had always had an interest in being
          able to catalog my collection and I finally started learning about
          databases, around 2019.
        </p>
        <p>
          Then between covid and having a job with a lot of down time, I managed
          to create a database and catalog all of my music which I have kept
          current ever since. I wanted my own custom way to interact with it,
          which led to my learning to write some code.
        </p>
        <p>
          I really enjoy and have fun when I write code. I do understand that AI
          coding has it's place, but I am not trying to farm out my fun. It's
          all human creations here on this site.
        </p>
        <p></p>
      </div>
      <div class='image-wrapper'>
        <Image
          src={profilePic}
          alt="Steve's Corner of the Internet"
        />
      </div>
    </div>

    <div>
      <h2>The Sides That Form The Corner</h2>
      <div class='topics-wrapper'>
        <div class='topic-card card-shadow'>
          <Image
            src={codingImage}
            alt='coding'
          />
          <div class='text-wrapper'>
            <h3>
              <a
                href='/coding'
                class='card-link'
                >Coding</a
              >
            </h3>
            <p>
              I absolutely love to code. I would love to be able to make a
              living doing it someday.
            </p>
          </div>
        </div>
        <div class='topic-card card-shadow'>
          <Image
            src={musicImage}
            alt='physical music collection'
          />
          <div class='text-wrapper'>
            <h3>
              <a
                href='/music'
                class='card-link'
                >Music</a
              >
            </h3>
            <p>
              A kick ass collection of physical media and music memorabilia.
            </p>
          </div>
        </div>
        <div class='topic-card card-shadow'>
          <Image
            src={nascarImage}
            alt='nascar races'
          />
          <div class='text-wrapper'>
            <h3>
              <a
                href='/nascar'
                class='card-link'
                >NASCAR</a
              >
            </h3>
            <p>
              My first race was in Loudon, NH in 2007. Here is my digital
              journal of races I have attended.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  body {
    padding-block-start: 5rem;
  }

  section {
    margin-inline: auto;
    max-width: var(--max-width);
    padding-inline: 2rem;
    /* margin-block-start: 2.5rem; */
    color: var(--text-color-700);

    h1 {
      font-size: 2.5rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block-end: 3rem;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    gap: 1.5rem;
    margin-block-end: 1rem;

    & > * {
      flex-basis: 50%;
    }
  }

  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      gap: 3rem;
    }
  }

  .image-wrapper {
    margin-block-start: 0.5rem;
    max-width: 350px;
    filter: drop-shadow(
      -2px 2px 7px hsl(from var(--text-color-700) h s l / 0.5)
    );

    img {
      width: 100%;
      height: auto;
      border-radius: 10px;
      display: block;
    }

    @media (min-width: 768px) {
      .image-wrapper {
        width: 50%;
        margin-bottom: 0rem;
        align-self: center;
      }
    }
  }

  /* @media (min-width: 768px) { */
  .hero-content-wrapper {
    max-width: 65ch;
  }
  /* } */

  h2 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-block: 3rem 1rem;
  }

  p {
    line-height: 1.65;
  }

  p {
    margin-block-end: 1lh;
  }

  .topics-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .topics-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .topics-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .topic-card {
    background-color: rgb(255 255 255);
    border-radius: 0.5rem;
    overflow: hidden;
    padding: 0.25rem;
    position: relative;
    cursor: pointer;
    outline: 1px solid hsl(from var(--text-color-700) h s l / 0.3);

    img {
      border-radius: 0.5rem;
      width: 100%;
      height: auto;
      /* outline: 1px solid hsl(from var(--text-color-700) h s l / 0.3); */
    }

    .text-wrapper {
      padding: 1.5rem;
    }

    h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-block-end: 0.5rem;
    }
  }

  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    outline: 2px solid lime;
  }
</style>
