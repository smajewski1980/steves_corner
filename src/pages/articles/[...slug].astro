---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils";
import Tags from "../../components/Tags.astro";

export async function getStaticPaths() {
  const allBlogArticles: CollectionEntry<"blog">[] =
    await getCollection("blog");

  return allBlogArticles.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: { entry },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Slug is required");
}

const entry = await getEntry("blog", slug);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<MainLayout>
  <section>
    <a
      href='/articles/'
      class='back-link'
      >Back To Articles</a
    >
    <article>
      <h1>
        {entry.data.title}
      </h1>
      <h3>
        Written by {entry.data.author} on {formatDate(entry.data.pubDate)}
      </h3>
      <Tags tags={entry.data.tags} />
      <img
        src={"/images/" + entry.data.image}
        alt='Article Image'
      />
      <Content />
    </article>
  </section>
</MainLayout>

<style>
  section {
    width: 100%;
    margin-inline: auto;
    max-width: var(--med-width);
    padding-inline: 2rem;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    a:not(article a) {
      color: var(--text-color-100);
      background-color: var(--text-color-700);
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
    }

    a:not(article a):hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    }

    a:not(article a):focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 5px;
    }

    h1 {
      margin-block: 2.5rem 1rem;
      font-weight: 700;
      font-size: 2.25rem;
    }

    h3 {
      font-size: 1.125rem;
      margin-block-end: 1.25rem;
    }

    img {
      width: 100%;
      height: auto;
      margin-block-end: 1.5rem;
      border-radius: 15px;
    }
  }
</style>
