---
import MainLayout from "../../../layouts/MainLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const allBlogArticles: CollectionEntry<"blog">[] = (
  await getCollection("blog")
).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

export async function getStaticPaths() {
  const allBlogArticles: CollectionEntry<"blog">[] =
    await getCollection("blog");

  // 1. Extract all tags from all articles and flatten them into a single array
  const allTags = allBlogArticles.flatMap((entry) => entry.data.tags || []);

  // 2. Deduplicate the tags using a Set so you only create one route per unique tag
  const uniqueTags = [...new Set(allTags)];

  // 3. Map over the unique tags to return the path objects
  return uniqueTags.map((tag) => {
    // Optional: filter articles that include this current tag
    const filteredArticles = allBlogArticles.filter((entry) =>
      entry.data.tags?.includes(tag),
    );

    return {
      params: { tag }, // Must be a string
      props: { posts: filteredArticles },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

if (!tag) {
  throw new Error("Tag is required.");
}
---

<MainLayout>
  <section>
    <a
      href='/articles/'
      class='back-link'
      >Back To Articles</a
    >
    <h1>
      Posts - {tag}
    </h1>

    <div class='card-wrapper'>
      {posts.map((post) => <ArticleCard article={post} />)}
    </div>
  </section>
</MainLayout>

<style>
  section {
    width: 100%;
    margin-inline: auto;
    max-width: var(--max-width);
    padding-inline: 2rem;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    .back-link {
      color: var(--text-color-100);
      background-color: var(--text-color-700);
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
      transition: all 0.1s ease;
    }

    .back-link:hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    }

    .back-link:focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 5px;
    }

    h1 {
      font-size: 2.5rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block: 2rem;
    }
  }

  .card-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .card-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .card-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
