---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import underConstruction from "../images/under-construction.webp";
import CodecademyCerts from "../components/CodecademyCerts.astro";
import CurrencyExchangeApp from "../components/CurrencyExchangeApp.astro";
---

<MainLayout>
  <section class='projects-section'>
    <h1>Coding Page</h1>

    <CodecademyCerts />

        <p class="temp-text">
          The first project I want to demo for you is The Majewski Collection
          App. It's a desktop app I made with Electron that I use to manage my
          database for my music collection's catalog. I am almost done with the
          video's intro and will post that as kind of a trailer soon.
        </p>
        <Image
          src={underConstruction}
          alt='a decorative image'
          class="under-construction"
        />
    
    <!-- <CurrencyExchangeApp /> -->
    
    
  </section>
</MainLayout>

<style>

  .projects-section {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 1rem;

    .temp-text {
    max-width: 65ch;
    margin-inline:auto;
    margin-block-end: 1rem;
    }

    .under-construction {
      max-width: 625px;
      width: 100%;
      margin-inline: auto;
      display: block;
      height: auto;
    }
  }
  
</style>
