---
import MainLayout from "../layouts/MainLayout.astro";
// import { Image } from "astro:assets";
// import underConstruction from "../images/under-construction.webp";
import CodecademyCerts from "../components/CodecademyCerts.astro";
// import CurrencyExchangeApp from "../components/CurrencyExchangeApp.astro";
import TmcApp from "../components/TmcApp.astro";
---

<MainLayout>
  <section class='projects-section'>
    <h1>Coding Page</h1>

    <CodecademyCerts />
    <TmcApp />

    <!-- <CurrencyExchangeApp /> -->
  </section>
</MainLayout>

<style>
  .projects-section {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 1rem;

    .temp-text {
      max-width: 65ch;
      margin-inline: auto;
      margin-block-end: 1rem;
    }

    .under-construction {
      max-width: 625px;
      width: 100%;
      margin-inline: auto;
      display: block;
      height: auto;
    }
  }
</style>
