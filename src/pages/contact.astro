---
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { Image } from "astro:assets";
import messengerSteve from "../images/messenger_steve_form.webp";
---

<MainLayout>
  <main id='contact-wrapper'>
    <div class='contact-head'>
      <h1>Contact Steve</h1>
      <div class='img-wrapper'>
        <Image
          src={messengerSteve}
          alt=''
        />
      </div>
    </div>
    <p>
      Would you like to comment on something you saw on my site? Or maybe you
      are another developer who would like to work on something together, feel
      free to reach out and say hi.
    </p>
    <ContactForm />
  </main>
</MainLayout>

<style>
  .contact-head {
    display: flex;
    flex-wrap: wrap;
    /* justify-content: space-between; */

    h1 {
      margin-block-end: 2rem;
    }

    .img-wrapper {
      max-width: 200px;
      margin-inline: auto;
      margin-block-end: 2rem;
      img {
        margin-inline: auto;
        width: 100%;
        height: auto;
      }
    }
  }

  p {
    max-width: 65ch;
    margin-block-end: 2rem;
  }

  #contact-wrapper {
    display: grid;
    place-content: center;
  }
</style>
