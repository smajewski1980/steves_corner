---
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { Image } from "astro:assets";
import messengerSteve from "../images/messenger_steve_form.webp";
---

<MainLayout>
  <main id='contact-wrapper'>
    <h1>Contact Steve</h1>
    <div class='contact-head'>
      <p>
        Would you like to comment on something you saw on my site? Or maybe you
        are another developer who would like to work on something together, feel
        free to reach out and say hi.
      </p>
      <div class='img-wrapper'>
        <Image
          src={messengerSteve}
          alt=''
        />
      </div>
    </div>
    <ContactForm />
  </main>
</MainLayout>

<style>
  h1 {
    margin-block-end: 2rem;
  }

  .contact-head {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    max-width: (--max-width);
    align-items: start;

    .img-wrapper {
      --shadow-clr: hsl(0 0 0 / 0.3);
      max-width: 200px;
      margin-inline: auto;
      margin-block-end: -0.35rem;
      position: relative;
      z-index: 999;

      /* pseudos are subtle shadows under the feet */
      /* right */
      &::after {
        content: "";
        height: 10px;
        width: 30px;
        position: absolute;
        bottom: -0.15rem;
        background-color: var(--shadow-clr);
        right: 2rem;
        display: block;
        rotate: 10deg;
        z-index: -1;
        filter: blur(6px);
        border-radius: 20px;
        box-shadow: 0px 0px 10px 0px var (--shadow-clr);
      }
      /* left */
      &::before {
        content: "";
        height: 10px;
        width: 15px;
        position: absolute;
        bottom: -0.25rem;
        background-color: var(--shadow-clr);
        left: 3rem;
        display: block;
        rotate: 10deg;
        z-index: -1;
        filter: blur(6px);
        border-radius: 20px;
        box-shadow: 0px 0px 10px 0px var (--shadow-clr);
      }

      img {
        margin-inline: auto;
        width: 100%;
        height: auto;
      }
    }
  }

  p {
    max-width: 35ch;
    margin-block-end: 2rem;
  }

  #contact-wrapper {
    display: grid;
    place-content: center;
    padding-inline: 1rem;
  }
</style>
