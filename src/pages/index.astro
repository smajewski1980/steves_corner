---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import heroTest from "../images/homepage_hero_test.webp";
---

<MainLayout>
  <h1>Welcome to Steve's Corner of the Internet!</h1>
  <Image
    class='hero-image'
    src={heroTest}
    alt=''
  />
</MainLayout>

<style>
  h1 {
    text-align: center;
    margin-block-end: 1lh;
  }

  .hero-image {
    border-radius: 15px;
    margin-inline: auto;
    display: block;
  }
</style>
