---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import heroTest from "../images/homepage_hero_test.webp";
---

<MainLayout>
  <h1>Welcome to Steve's Corner of the Internet!</h1>
  <div class='hero'>
    <div class='hero-text-wrapper'>
      <p>
        Hello and welcome to my corner of the internet. I am Steve and this site
        was built by just I, not AI. I won't say I never ask AI for help through
        a google search, but I certainly do not ask it for code.
      </p>
      <p>
        This site is my personal journal of sorts for coding projects, some cool
        music collection items and my digital Nascar scrapbook containing all my
        ticket stubs along with some pics and video from all the races I have
        been to since 2007.
      </p>
      <p>
        So come on in and look around, and be sure to check back there will be
        new items added often.
      </p>
    </div>
    <div class='image-wrapper'>
      <Image
        class='hero-image'
        src={heroTest}
        alt=''
      />
    </div>
  </div>
</MainLayout>

<style>
  h1 {
    text-align: center;
    margin-block: 1rem 2rem;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    align-items: center;
    margin-block-end: 2rem;

    & > * {
      flex-basis: calc(50% - 2rem);

      @media (max-width: 1000px) {
        flex-basis: 100%;
      }
    }
  }

  .hero-text-wrapper {
    display: grid;
    gap: 1rem;

    p {
      margin-inline-start: auto;
      width: 75%;

      @media (max-width: 1000px) {
        margin-inline: auto;
      }
    }
  }

  .image-wrapper {
    min-width: 500px;
    @media (max-width: 525px) {
      width: 100%;
      height: auto;
    }
  }

  .hero-image {
    border-radius: 15px;
    display: block;
    width: 60%;
    height: auto;
    margin-inline-start: 15%;

    @media (max-width: 1000px) {
      margin-inline: auto;
      margin-block-start: 2rem;
    }
  }
</style>
