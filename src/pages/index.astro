---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import heroTest from "../images/homepage_hero_test.webp";
---

<MainLayout>
  <h1>Welcome to Steve's Corner of the Internet!</h1>
  <div class='hero'>
    <div class='hero-text-wrapper'>
      <p>
        Hi! I'm Steve and welcome to my corner of the internet. This site was
        built by just I, not AI.
      </p>
      <p>
        This site is my personal journal of sorts for my coding projects, some
        cool music collection items I have acquired over the years and my
        digital Nascar scrapbook for all the races I have been to.
      </p>
      <p>
        So come on in and look around, and be sure to check back there will be
        new items added often.
      </p>
    </div>
    <div class='image-wrapper'>
      <Image
        class='hero-image'
        src={heroTest}
        alt=''
      />
    </div>
  </div>
</MainLayout>

<style>
  h1 {
    text-align: center;
    margin-block: 1rem 2rem;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    align-items: center;
    margin-block-end: 2rem;

    & > * {
      flex-basis: calc(50% - 2rem);

      @media (max-width: 1000px) {
        flex-basis: 100%;
      }
    }
  }

  .hero-text-wrapper {
    display: grid;
    gap: 1rem;

    p {
      margin-inline-start: auto;
      width: 75%;

      @media (max-width: 1000px) {
        margin-inline: auto;
      }
    }
  }

  .image-wrapper {
    min-width: 500px;
    @media (max-width: 525px) {
      width: 100%;
      height: auto;
    }
  }

  .hero-image {
    border-radius: 15px;
    display: block;
    width: 60%;
    height: auto;
    margin-inline-start: 15%;

    @media (max-width: 1000px) {
      margin-inline: auto;
      margin-block-start: 2rem;
    }
  }
</style>
