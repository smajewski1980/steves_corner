---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Tags from "../../components/Tags.astro";
import { Image } from "astro:assets";
import BackButton from "../../components/BackButton.astro";
import BackToTop from "../../components/BackToTop.astro";
import PrevNextLinks from "../../components/PrevNextLinks.astro";

export async function getStaticPaths() {
  const allMusicArticles: CollectionEntry<"music">[] =
    await getCollection("music");

  allMusicArticles.sort(
    (a: CollectionEntry<"music">, b: CollectionEntry<"music">) =>
      a.data.title.localeCompare(b.data.title),
  );

  return allMusicArticles.map((entry, index) => ({
    params: {
      slug: entry.id,
    },
    props: {
      entry,
      prevEntry: index > 0 ? allMusicArticles[index - 1] : null,
      nextEntry:
        index < allMusicArticles.length - 1
          ? allMusicArticles[index + 1]
          : null,
    },
  }));
}

const { slug } = Astro.params;
const { nextEntry, prevEntry } = Astro.props;

const entry = await getEntry("music", slug);

if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<MainLayout>
  <section>
    <BackButton />
    <article>
      <div class='viewport-container'>
        <div class='evil-wizard-float'></div>
      </div>
      <h1>
        {entry.data.title}
      </h1>
      <PrevNextLinks
        prev={prevEntry}
        next={nextEntry}
        animateSteve={true}
      />
      <p class='item-year'>{entry.data.year}</p>

      <p class='category-link'>
        Category: <a href=`/music/category/${entry.data.category}`
          >{entry.data.category.replace("-", " ")}</a
        >
      </p>

      <Tags
        tags={entry.data.tags}
        isMusicTags={true}
      />
      <Image
        src={entry.data.coverImage}
        alt={entry.data.coverImageAlt}
      />
      <div class='content-component-wrapper'>
        <Content />
      </div>
      <PrevNextLinks
        prev={prevEntry}
        next={nextEntry}
      />
    </article>
    <BackButton />
    <BackToTop />
  </section>
</MainLayout>

<style>
  body {
    padding-block-start: 5rem;
  }

  section {
    margin-inline: auto;
    max-width: calc(var(--max-width) - 4rem);
    padding-inline: 1rem;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    .back-link:has(+ .back-to-top) {
      margin-block-start: 2rem;
    }

    a:not(article a) {
      color: var(--text-color-100);
      background-color: var(--text-color-700);
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
    }

    a:not(article a):hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    }

    a:not(article a):focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 5px;
    }

    h1 {
      margin-block: 2.5rem 1rem;
      font-weight: 700;
      font-size: clamp(1.5rem, 1.2065rem + 1.3043vw, 2.25rem);
    }

    h2 {
      margin-block: 1lh 0.5lh;
    }

    img {
      width: 100%;
      height: auto;
      margin-block-end: 1.5rem;
      border-radius: 15px;
    }

    p {
      max-width: 70ch;
      margin-inline: auto;
      text-align: center;
    }

    .item-year {
      text-align: left;
      margin: 0;
      font-size: 1.25rem;
    }

    .category-link {
      font-size: 1.125rem;
      margin-block-end: 1.25rem;
      margin-inline: 0;
      text-align: start;
      text-transform: capitalize;
      position: relative;
      z-index: 9999;
    }
  }

  .content-component-wrapper :global(svg) {
    margin-inline-start: 0.25rem;
  }

  .content-component-wrapper :global(p) {
    margin-block-end: 2lh;
  }
</style>
