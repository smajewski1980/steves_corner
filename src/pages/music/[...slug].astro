---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Tags from "../../components/Tags.astro";
import { Image } from "astro:assets";
import BackButton from "../../components/BackButton.astro";

export async function getStaticPaths() {
  const allMusicArticles: CollectionEntry<"music">[] =
    await getCollection("music");

  return allMusicArticles.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: { entry },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Slug is required");
}

const entry = await getEntry("music", slug);

if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<MainLayout>
  <section>
    <BackButton />
    <article>
      <h1>
        {entry.data.title}
      </h1>

      <Tags tags={entry.data.tags} />
      <Image
        src={entry.data.coverImage}
        alt='Article Image'
      />
      <div class='content-component-wrapper'>
        <Content />
      </div>
    </article>
    <BackButton />
  </section>
</MainLayout>

<style>
  section {
    width: 100%;
    margin-inline: auto;
    max-width: var(--med-width);
    padding-inline: 2rem;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    a:not(article a) {
      color: var(--text-color-100);
      background-color: var(--text-color-700);
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
    }

    a:not(article a):hover {
      color: var(--text-color-700);
      background-color: var(--text-color-100);
    }

    a:not(article a):focus-visible {
      outline: 1px solid var(--text-color-700);
      outline-offset: 5px;
    }

    h1 {
      margin-block: 2.5rem 1rem;
      font-weight: 700;
      font-size: 2.25rem;
    }

    h3 {
      font-size: 1.125rem;
      margin-block-end: 1.25rem;
    }

    img {
      width: 100%;
      height: auto;
      margin-block-end: 1.5rem;
      border-radius: 15px;
    }

    p {
      max-width: 70ch;
      margin-inline: auto;
      text-align: center;
    }
  }
  .content-component-wrapper :global(a) {
    text-decoration: underline;
    text-underline-offset: 5px;
    .ext-link-icon::after {
      content: url("/public/external-link-svg.svg");
      padding-inline-start: 0.25rem;
    }
  }
</style>
