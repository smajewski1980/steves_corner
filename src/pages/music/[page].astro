---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
// import SearchForm from "../../components/SearchForm.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { ARTICLES_PER_PAGE } from "../../constants";
import Pagination from "../../components/Pagination.astro";

// export const getStaticPaths = (async ({ paginate }) => {
//   const allBlogArticles: CollectionEntry<"blog">[] = (
//     await getCollection("blog")
//   ).sort(
//     (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
//       b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
//   );

//   return paginate(allBlogArticles, { pageSize: ARTICLES_PER_PAGE });
// }) satisfies GetStaticPaths;

export const getStaticPaths = (async ({ paginate }) => {
  const allMusicArticles: CollectionEntry<"music">[] = (
    await getCollection("music")
  ).sort(
    (a: CollectionEntry<"music">, b: CollectionEntry<"music">) =>
      b.data.dateAdded.valueOf() - a.data.dateAdded.valueOf(),
  );

  return paginate(allMusicArticles, { pageSize: ARTICLES_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const prevUrl = page.url.prev;
const nextUrl = page.url.next;
---

<MainLayout>
  <section>
    <h1>Music Posts</h1>

    <!-- for now -->
    <!-- <SearchForm /> -->
    <CategoryNav />

    <div class='card-wrapper'>
      {page.data.map((article) => <ArticleCard article={article} />)}
    </div>
    <Pagination
      prevUrl={prevUrl}
      currentPageRange={undefined}
      nextUrl={nextUrl}
    />
  </section>
</MainLayout>

<style>
  section {
    margin-inline: auto;
    max-width: var(--max-width);
    padding-inline: 2rem;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    h1 {
      font-size: 2.5rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block: 1rem 2rem;
    }
  }

  .card-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2rem;
  }
  @media (min-width: 640px) {
    .card-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .card-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
