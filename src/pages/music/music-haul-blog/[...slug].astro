---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../../layouts/MainLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../../utils";
import { Image } from "astro:assets";
import BackButton from "../../../components/BackButton.astro";
import BackToTop from "../../../components/BackToTop.astro";
import PrevNextLinks from "../../../components/PrevNextLinks.astro";

export const getStaticPaths = (async () => {
  const allMusicHaulPosts: CollectionEntry<"musicHaulBlog">[] = (
    await getCollection("musicHaulBlog")
  ).sort(
    (
      a: CollectionEntry<"musicHaulBlog">,
      b: CollectionEntry<"musicHaulBlog">,
    ) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return allMusicHaulPosts.map(
    (post: CollectionEntry<"musicHaulBlog">, index) => ({
      params: {
        slug: post.id,
      },
      props: {
        post,
        prevPost: index > 0 ? allMusicHaulPosts[index - 1] : null,
        nextPost:
          index < allMusicHaulPosts.length - 1
            ? allMusicHaulPosts[index + 1]
            : null,
      },
    }),
  );
}) satisfies GetStaticPaths;

const { post, prevPost, nextPost } = Astro.props;

if (!post) return Astro.redirect("/404");

const { Content } = await render(post);
---

<MainLayout>
  <section>
    <BackButton />
    <article>
      <h1>{post.data.title}</h1>
      <PrevNextLinks
        prev={prevPost}
        next={nextPost}
        isMusicBlog={true}
      />
      <p>{formatDate(post.data.date)}</p>

      <Image
        src={post.data.coverImage}
        alt={post.data.coverImageAlt}
      />
      <div class='content-component-wrapper'>
        <Content />
      </div>
      <PrevNextLinks
        prev={prevPost}
        next={nextPost}
        isMusicBlog={true}
      />
    </article>
    <BackButton />
  </section>
  <BackToTop />
</MainLayout>

<style>
  section {
    margin-inline: auto;
    padding-inline: 1rem;
  }
  h1 {
    margin-block: 2rem;
  }
  img {
    max-width: 100%;
    height: auto;
  }

  .content-component-wrapper {
    margin-block-end: 2rem;

    img {
      max-width: 100%;
      height: auto;
    }

    p,
    h1 {
      max-width: 70ch;
      margin-inline: auto;
      text-align: center;
    }

    p {
      margin-block-end: 3rem;
    }

    iframe {
      margin-block-end: 1rem;
    }
  }
</style>
