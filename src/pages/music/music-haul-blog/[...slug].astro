---
import type { GetStaticPaths } from "astro";
import MainLayout from "../../../layouts/MainLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../../utils";
import { Image } from "astro:assets";
import BackButton from "../../../components/BackButton.astro";
import BackToTop from "../../../components/BackToTop.astro";
import PrevNextLinks from "../../../components/PrevNextLinks.astro";

export const getStaticPaths = (async () => {
  const allMusicHaulPosts: CollectionEntry<"musicHaulBlog">[] = (
    await getCollection("musicHaulBlog")
  ).sort(
    (
      a: CollectionEntry<"musicHaulBlog">,
      b: CollectionEntry<"musicHaulBlog">,
    ) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return allMusicHaulPosts.map(
    (post: CollectionEntry<"musicHaulBlog">, index) => ({
      params: {
        slug: post.id,
      },
      props: {
        post,
        prevPost: index > 0 ? allMusicHaulPosts[index - 1] : null,
        nextPost:
          index < allMusicHaulPosts.length - 1
            ? allMusicHaulPosts[index + 1]
            : null,
      },
    }),
  );
}) satisfies GetStaticPaths;

const { post, prevPost, nextPost } = Astro.props;

if (!post) return Astro.redirect("/404");

const { Content } = await render(post);
---

<MainLayout>
  <section>
    <BackButton />
    <article>
      <div class='viewport-container'>
        <div class='evil-wizard-float'></div>
      </div>
      <h1>{post.data.title}</h1>
      <p>{formatDate(post.data.date)}</p>
      <PrevNextLinks
        prev={prevPost}
        next={nextPost}
        isMusicBlog={true}
        animateSteve={true}
      />

      <Image
        src={post.data.coverImage}
        alt={post.data.coverImageAlt}
      />
      <div class='content-component-wrapper'>
        <Content />
      </div>
      <PrevNextLinks
        prev={prevPost}
        next={nextPost}
        isMusicBlog={true}
      />
    </article>
    <BackButton />
  </section>
  <BackToTop />
</MainLayout>

<style>
  body {
    padding-block-start: 5rem;
  }
  section {
    margin-inline: auto;
    padding-inline: 1rem;
    padding-block-start: 1rem;
    max-width: calc(var(--max-width) - 4rem);

    @media (max-width: 768px) {
      .prev-next-links-wrapper {
        justify-content: start;
      }
    }
  }
  article {
    margin-block-start: 3rem;

    h1 {
      margin-block: 2rem 1rem;
      max-width: var(--max-width);
    }

    p {
      margin-block-end: 2rem;
    }
    img {
      display: block;
      margin-block-start: 2rem;
      max-width: 100%;
      height: auto;
    }
  }

  .content-component-wrapper {
    margin-block-end: 2rem;

    img {
      max-width: 100%;
      height: auto;
    }

    p,
    h1 {
      max-width: 70ch;
      margin-inline: auto;
      text-align: center;
    }

    p {
      margin-block-end: 3rem;
    }

    iframe {
      margin-block-end: 1rem;
    }
  }
</style>
