---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BackButton from "../../components/BackButton.astro";
import BackToTop from "../../components/BackToTop.astro";
import TargetCdCard from "../../components/TargetCdCard.astro";
import ExternalLinkIcon from "../../../public/external-link-svg.svg";

const allTargetCds = await getCollection("targetCds");
const currentQty = allTargetCds.length;

const aCds = (
  await getCollection("targetCds", (entry: CollectionEntry<"targetCds">) => {
    return entry.data.artist.toLowerCase().startsWith("a");
  })
).sort((a, b) => a.data.artist.localeCompare(b.data.artist));
