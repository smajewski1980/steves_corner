<MainLayout>
  <BackButton />
  <h1>Target CD Collection</h1>
  <p class='disc-qty'>Currently {currentQty} discs.</p>

  <p>
    ADD A LINK TO INFO HERE. If you see multiples, it's not an error, they are
    separate items with separate scans. Sometimes they will be variants with
    minor differences, sometimes they will be duplicates in the collection.
  </p>

  <section
    id='jump-to-a'
    class='jump-to-link'
  >
    <h2>A</h2>
    <div class='target-card-wrapper'>
