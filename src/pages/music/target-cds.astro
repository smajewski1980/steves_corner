  <style>
    h1 {
      margin-block: 2rem 0.5rem;
    }

    svg {
      margin-inline-start: 0.25rem;
    }

    .disc-qty {
      margin-block-end: 1rem;
    }

    .jump-to-nav {
      margin-block-end: 1rem;
      font-size: 1.25rem;
    }

    .text-wrapper {
      display: grid;
      gap: 1rem;
      line-height: 1.2;

      a {
        text-decoration: underline;
        text-underline-offset: 5px;
      }

      span {
        width: 1rem;
        height: 1rem;
        margin-inline: 0.5rem 0.25rem;
        outline: 1px solid var(--text-color-700);
        display: inline-block;
      }
      .jpn {
        background-color: var(--jpn);
      }
      .wg {
        background-color: var(--wg);
      }
      .other {
        background-color: var(--other);
      }
    }

    .jump-to-link {
      margin-block-start: 1.5rem;
      padding: 0;
      h2 {
        border-bottom: 1px solid var(--text-color-700);
        padding-block-end: 1rem;
        margin-block-end: 1rem;
      }
    }

    .target-card-wrapper {
      /* i tried dividing by 2, but it wrapped too early, so dividing by 3 and 
        not counting the gap makes two columns that wrap at a nice point */
      --max-card-width: calc((var(--max-width) / 3));

      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(min(100%, var(--max-card-width)), 1fr)
      );
      align-items: center;
      gap: 1rem;
    }
  </style>
</MainLayout>
