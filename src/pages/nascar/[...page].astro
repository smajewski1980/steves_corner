---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import NascarPostCard from "../../components/NascarPostCard.astro";
import SearchForm from "../../components/SearchForm.astro";
import Pagination from "../../components/Pagination.astro";
import { ARTICLES_PER_PAGE } from "../../constants";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  const allNascarPosts: CollectionEntry<"nascar">[] = (
    await getCollection("nascar")
  ).sort(
    (a: CollectionEntry<"nascar">, b: CollectionEntry<"nascar">) =>
      b.data.raceDate.valueOf() - a.data.raceDate.valueOf(),
  );

  return paginate(allNascarPosts, { pageSize: ARTICLES_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const prevUrl = page.url.prev;
const nextUrl = page.url.next;
---

<MainLayout>
  <section>
    <!-- maybe at the top of the category pages like this we put that most recent post component -->
    <h1>Nascar Posts</h1>

    <SearchForm />

    <div class='nascar-card-wrapper'>
      {page.data.map((post) => <NascarPostCard post={post} />)}
    </div>
    <Pagination
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
  </section>
</MainLayout>

<style>
  section {
    max-width: var(--max-width);
    margin-inline: auto;
    margin-block-start: 2.5rem;
    padding-inline: 2rem;
    color: var(--text-color-700);

    h1 {
      font-size: 2.5rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block: 1rem 2rem;
    }
  }

  .nascar-card-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .nascar-card-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .nascar-card-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
