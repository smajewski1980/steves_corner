---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import NascarPostCard from "../../components/NascarPostCard.astro";
// import SearchForm from "../../components/SearchForm.astro";
import Pagination from "../../components/Pagination.astro";
import NascarStats from "../../components/NascarStats.astro";
import { ARTICLES_PER_PAGE } from "../../constants";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { formatDate } from "../../utils";

export const getStaticPaths = (async ({ paginate }) => {
  const allNascarPosts: CollectionEntry<"nascar">[] = (
    await getCollection("nascar")
  ).sort(
    (a: CollectionEntry<"nascar">, b: CollectionEntry<"nascar">) =>
      b.data.raceDate.valueOf() - a.data.raceDate.valueOf(),
  );

  return paginate(allNascarPosts, { pageSize: ARTICLES_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const prevUrl = page.url.prev;
const nextUrl = page.url.next;

const pageDates = page.data.map((post) => post.data.raceDate);
const dateRangeHigh = pageDates[0];
const dateRangeLow = pageDates[pageDates.length - 1];
const currentPageRange = {
  high: formatDate(dateRangeHigh),
  low: formatDate(dateRangeLow),
};
---

<MainLayout>
  <section>
    <!-- maybe at the top of the category pages like this we put that most recent post component -->
    <h1>Nascar Posts</h1>

    <!-- <SearchForm /> -->
    <p>
      Welcome to my digital Nascar scrapbook. I went to my first race in 2007,
      since then, I've gone to a few more... Since I am making this website long
      after most of these races occurred, there may be less comments in some
      posts than others.
    </p>
    <p>
      There were a few races that I couldn't find any pictures that we took....
      But for the most part, in addition to the ticket stubs, I added a few race
      pics, video if I had it and there are some pit passes in there too.
    </p>
    <p>
      At the bottom of the page, check out my stats and a link to my race
      weather page that I made for myself to see the weather for the upcoming
      race weekend.
    </p>
    <Pagination
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      currentPageRange={currentPageRange}
    />
    <div class='nascar-card-wrapper'>
      {page.data.map((post) => <NascarPostCard post={post} />)}
    </div>
    <Pagination
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      currentPageRange={currentPageRange}
    />
  </section>
  <NascarStats />
</MainLayout>

<style>
  section {
    max-width: var(--max-width);
    margin-inline: auto;
    margin-block-start: 2.5rem;

    color: var(--text-color-700);

    h1 {
      font-size: 2.5rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block: 1rem 2rem;
    }

    /* p {
      line-height: 1.6;
    } */
  }

  .nascar-card-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .nascar-card-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* padding-inline: 2rem; */
    }
  }

  @media (min-width: 1024px) {
    .nascar-card-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
