---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import NascarPostCard from "../../components/NascarPostCard.astro";
import SearchForm from "../../components/SearchForm.astro";
import Pagination from "../../components/Pagination.astro";
import { ARTICLES_PER_PAGE } from "../../constants";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  const allNascarPosts: CollectionEntry<"nascar">[] = (
    await getCollection("nascar")
  ).sort(
    (a: CollectionEntry<"nascar">, b: CollectionEntry<"nascar">) =>
      b.data.raceDate.valueOf() - a.data.raceDate.valueOf(),
  );

  return paginate(allNascarPosts, { pageSize: ARTICLES_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const prevUrl = page.url.prev;
const nextUrl = page.url.next;
---

<MainLayout>
  <section class='container mx-auto max-w-screen-xl mt-10 px-8'>
    <h1 class='text-5xl font-bold mt-4 mb-8 leading-tight xl:text-6xl'>
      All Nascar Posts
    </h1>

    <SearchForm />

    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
      {page.data.map((post) => <NascarPostCard post={post} />)}
    </div>
    <Pagination
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
  </section>
</MainLayout>
