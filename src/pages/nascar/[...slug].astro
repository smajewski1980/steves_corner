---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils";
import Tags from "../../components/Tags.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const allNascarPosts: CollectionEntry<"nascar">[] =
    await getCollection("nascar");

  return allNascarPosts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: { post },
  }));
}

const { slug } = Astro.params;

if (!slug) throw new Error("Slug is required");

const entry = await getEntry("nascar", slug);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<MainLayout>
  <main>
    <h1 class='nascar-post-header'>{entry.data.raceTitle}</h1>
    <h2>{formatDate(entry.data.raceDate)}</h2>
    <p class='race-winner'>
      <strong>Race Winner: <em>{entry.data.raceWinner}</em></strong>
    </p>
    <Image
      src={entry.data.mainImage}
      alt={entry.data.mainImageAlt}
    />
    <div class='contentWrapper'>
      <Content />
    </div>
  </main>
</MainLayout>
<!-- need a back to top button -->
<style>
  main {
    color: var(--text-color-700);
  }
  .nascar-post-header,
  h2 {
    text-align: center;
    margin-block-end: 2rem;
    font-weight: 600;
    font-size: 2.5rem;
  }

  h2 {
    font-size: 1.5rem;
  }

  p {
    text-align: center;
  }

  .race-winner {
    margin-block-end: 5rem;

    em {
      font-size: 1.25rem;
    }
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;

    &:first-of-type {
      margin-block-end: 3rem;
    }
  }

  .contentWrapper {
    max-width: var(--max-width);
    margin-inline: auto;
    color: var(--text-color-700);

    p {
      text-align: center;
      margin-block-end: 3rem;
      max-width: 60ch;
      margin-inline: auto;
    }

    img {
      max-width: 750px;
      width: 100%;
      height: auto;
      margin-inline: auto;
      display: block;
    }

    h3 {
      font-size: 2rem;
      text-align: center;
    }
  }
</style>
