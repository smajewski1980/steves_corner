---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils";
import Tags from "../../components/Tags.astro";
import BackToTop from "../../components/BackToTop.astro";
import { Image } from "astro:assets";
import BackButton from "../../components/BackButton.astro";
import PrevNextLinks from "../../components/PrevNextLinks.astro";

export async function getStaticPaths() {
  const allNascarPosts: CollectionEntry<"nascar">[] = (
    await getCollection("nascar")
  ).toSorted(
    (a: CollectionEntry<"nascar">, b: CollectionEntry<"nascar">) =>
      b.data.raceDate.valueOf() - a.data.raceDate.valueOf(),
  );

  return allNascarPosts.map((post, index) => ({
    params: {
      slug: post.id.replace(/\/index$/, ""),
    },
    props: {
      post,
      prevPost: index > 0 ? allNascarPosts[index - 1] : null,
      nextPost:
        index < allNascarPosts.length - 1 ? allNascarPosts[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<MainLayout>
  <main>
    <BackButton />
    <h1 class='nascar-post-header'>{post.data.raceTitle}</h1>
    <h2>{formatDate(post.data.raceDate)}</h2>
    <PrevNextLinks
      prev={prevPost}
      next={nextPost}
      isNascarPost={true}
    />
    <p class='race-winner'>
      <strong>Race Winner: <em>{post.data.raceWinner}</em></strong>
    </p>
    <div class='tags-wrapper'>
      <Tags tags={post.data.tags} />
    </div>
    <Image
      src={post.data.mainImage}
      alt={post.data.mainImageAlt}
    />
    <div class='content-wrapper'>
      <Content />
    </div>
    <PrevNextLinks
      prev={prevPost}
      next={nextPost}
      isNascarPost={true}
    />
    <BackToTop />
    <BackButton />
  </main>
</MainLayout>

<style>
  main {
    color: var(--text-color-700);
    padding-inline: 1.5rem;
    max-width: var(--max-width);
    margin-inline: auto;

    #back-button {
      margin-block: 2rem 4rem;
      margin-inline-start: 2rem;
    }

    @media (max-width: 768px) {
      .prev-next-links-wrapper {
        justify-content: center;
      }
    }
  }

  .nascar-post-header,
  h2 {
    text-align: center;
    margin-block-end: 2rem;
    font-weight: 600;
    font-size: 2.5rem;
  }

  h2 {
    font-size: 1.5rem;
  }

  p {
    text-align: center;
  }

  .race-winner {
    margin-block-end: 2rem;
    em {
      font-size: 1.25rem;
      z-index: 9999;
      position: relative;
    }
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .tags-wrapper {
    display: grid;
    justify-content: center;
    margin-block-end: 5rem;

    h4 {
      text-align: center;
    }
  }
  .content-wrapper {
    max-width: var(--max-width);
    margin-inline: auto;
    color: var(--text-color-700);

    p {
      text-align: center;
      max-width: 60ch;
      margin-inline: auto;
      margin-block: 0.5rem 2.5rem;
    }

    img {
      max-width: 750px;
      width: 100%;
      height: auto;
      margin-inline: auto;
      display: block;
    }

    .taller-image {
      max-height: 350px;
      width: auto;
    }

    .ufp {
      max-height: 175px;
    }

    .ticketmaster {
      max-width: 375px;
    }

    h2 {
      text-align: center;
      margin-block-end: 2rem;
    }

    h3 {
      font-size: 2rem;
      text-align: center;
    }
  }

  /* edge case styles */
  /* if a post starts with an img under the cover image */
  main:has(.content-wrapper > :first-child:is(img))
    img:not(.content-wrapper img) {
    margin-block-end: 3rem;
  }
  /* if a post starts with an iframe under the cover img, this hits cover img */
  main:has(.content-wrapper > :first-child:is(iframe))
    img:not(.content-wrapper img) {
    margin-block-end: 3rem;
  }
  /* in the post if an img is followed by another img */
  .content-wrapper :global(img:has(+ img)) {
    margin-block-end: 3rem;
  }
  /* in the post if an image is followed by an iframe */
  .content-wrapper :global(img:has(+ iframe)) {
    margin-block-end: 3rem;
  }
</style>
