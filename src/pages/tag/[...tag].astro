---
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import NascarPostCard from "../../components/NascarPostCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { HA_ATTRIBUTION } from "../../constants";

// const allBlogArticles: CollectionEntry<"blog">[] = (
//   await getCollection("blog")
// ).sort(
//   (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
//     b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );

export async function getStaticPaths() {
  const allMusicArticles: CollectionEntry<"music">[] =
    await getCollection("music");

  const allNascarPosts: CollectionEntry<"nascar">[] =
    await getCollection("nascar");

  const allContent = [...allMusicArticles, ...allNascarPosts];

  // 1. Extract all tags from all articles and flatten them into a single array
  const allTags = allContent.flatMap((entry) => entry.data.tags || []);

  // 2. Deduplicate the tags using a Set so you only create one route per unique tag
  const uniqueTags = [...new Set(allTags)];

  // 3. Map over the unique tags to return the path objects
  return uniqueTags.map((tag) => {
    // Optional: filter articles that include this current tag
    const filteredContent = allContent.filter((entry: any) =>
      entry.data.tags?.includes(tag),
    );

    return {
      params: { tag }, // Must be a string
      props: { posts: filteredContent },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

if (!tag) {
  throw new Error("Tag is required.");
}

// Peek at the first post to detect the active collection
const activeCollection = posts[0]?.collection;
// set the heading text accordingly
const headingText = activeCollection === "music" ? "Music " : "Nascar ";
---

<MainLayout>
  <section>
    <button
      class='back-link'
      id='back-button'
      >Back</button
    >
    <h1>
      {headingText}items tagged with: {tag}
    </h1>

    <p><span class='asterisk'>*</span>: {HA_ATTRIBUTION}</p>

    <div class='card-wrapper'>
      {
        posts.map((post: any) => {
          if (post.collection === "music") {
            return <ArticleCard article={post} />;
          } else if (post.collection === "nascar") {
            return <NascarPostCard post={post} />;
          }
        })
      }
    </div>
  </section>
</MainLayout>

<script>
  function setupBackButton() {
    const backBtn = document.getElementById("back-button");
    if (!backBtn) return;

    backBtn.addEventListener("click", () => {
      // Check if the user came from this site
      const hasInternalReferrer =
        document.referrer && document.referrer.includes(window.location.host);

      if (hasInternalReferrer && window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/nascar/";
      }
    });
  }

  setupBackButton();
</script>

<style>
  section {
    width: 100%;
    margin-inline: auto;
    max-width: var(--max-width);
    padding-inline: 2rem;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    h1 {
      font-size: 1.75rem;
      line-height: 1.25;
      font-weight: 700;
      margin-block: 2rem;
    }
  }

  .asterisk {
    color: var(--asterisk);
    font-size: 1rem;
  }

  .card-wrapper {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .card-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .card-wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
