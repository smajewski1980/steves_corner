---
import type { Page, GetStaticPathsOptions, GetStaticPathsResult } from "astro";
import MainLayout from "../../../layouts/MainLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import NascarPostCard from "../../../components/NascarPostCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { HA_ATTRIBUTION, MUSIC_CARDS_PER_PAGE } from "../../../constants";
import BackButton from "../../../components/BackButton.astro";
import Pagination from "../../../components/Pagination.astro";

interface Props {
  page: Page<CollectionEntry<"music">>;
}

export const getStaticPaths = async ({
  paginate,
}: GetStaticPathsOptions): Promise<GetStaticPathsResult> => {
  const allMusicArticles: CollectionEntry<"music">[] =
    await getCollection("music");

  const allNascarPosts: CollectionEntry<"nascar">[] =
    await getCollection("nascar");

  const allContent = [...allMusicArticles, ...allNascarPosts];

  // 1. Extract all tags from all articles and flatten them into a single array
  const allTags = allContent.flatMap((entry) => entry.data.tags || []);

  // 2. Deduplicate the tags using a Set so you only create one route per unique tag
  const uniqueTags = [...new Set(allTags)].map((tag) =>
    tag === "R.E.M." ? "rem" : tag,
  );

  // 3. Map over the unique tags to return the path objects
  return uniqueTags.flatMap((tag) => {
    const filteredContent = allContent.filter((entry: any) =>
      entry.data.tags?.includes(tag === "rem" ? "R.E.M." : tag),
    );

    return paginate(filteredContent, {
      params: { tag },
      pageSize: MUSIC_CARDS_PER_PAGE,
    });
  });
};

const { page } = Astro.props;
const { tag } = Astro.params;
const prevUrl = page.url.prev;
const nextUrl = page.url.next;

if (!tag) {
  throw new Error("Tag is required.");
}

// Peek at the first post to detect the active collection
const activeCollection = page.data[0]?.collection;
// set the heading text accordingly
const headingText = activeCollection === "music" ? "Music " : "Nascar ";
---

<MainLayout>
  <section>
    <BackButton />
    <h1 class='tag-page-heading'>
      {headingText}items tagged with: {
        tag === "rem" ? "R.E.M." : tag.replaceAll("-", " ")
      }
    </h1>

    {
      activeCollection === "music" && (
        <p>
          <span class='asterisk'>*</span>: {HA_ATTRIBUTION}
        </p>
      )
    }

    <div class='card-wrapper'>
      {
        page.data.map((post: any) => {
          if (post.collection === "music") {
            return <ArticleCard article={post} />;
          } else if (post.collection === "nascar") {
            return <NascarPostCard post={post} />;
          }
        })
      }
    </div>
    <Pagination
      prevUrl={prevUrl}
      currentPageRange={undefined}
      currentPage={page.currentPage}
      nextUrl={nextUrl}
    />
    <BackButton />
  </section>
</MainLayout>

<style>
  section {
    margin-inline: auto;
    margin-block-start: 3.5rem;
    color: var(--text-color-700);

    #back-button {
      margin-block-start: 2rem;
    }
  }
  .tag-page-heading {
    font-size: var(--heading-1-size);
    line-height: 1.25;
    font-weight: 700;
    margin-block-start: 2rem;
    text-transform: capitalize;
  }

  .asterisk {
    color: var(--text-color-700);
    font-size: 1rem;
  }

  p {
    margin-block-end: 2rem;
  }

  .card-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 275px), 1fr));
    gap: 2rem 1rem;
  }
</style>
